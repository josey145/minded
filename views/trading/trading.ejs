 <%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="../../css/trading.css">

<div class="trading-container">
    <div class="trading-header">
        <div>
            <h1 class="trading-title">Forex Trading</h1>
            <p class="trading-subtitle">Trade currency pairs with leverage. Real market execution.</p>
        </div>
        <form action="/trading/switch-account" method="POST" class="account-switcher">
            <button type="submit" name="account_type" value="real" 
                class="account-switch-btn <%= account.accountType === 'real' ? 'active real' : '' %>">
                💰 Real Account
            </button>
            <button type="submit" name="account_type" value="demo" 
                class="account-switch-btn <%= account.accountType === 'demo' ? 'active demo' : '' %>">
                🎮 Demo Account
            </button>
        </form>
    </div>

    <!-- Account Type Banner with Create Account Button -->
    <div class="account-type-banner <%= account.accountType %>">
        <div class="banner-left">
            <span style="font-size:18px;"><%= account.accountType === 'demo' ? '🎮' : '💰' %></span>
            <span>
                You are trading on <strong><%= account.accountType.toUpperCase() %></strong> account
                <%= account.accountType === 'demo' ? '(Virtual $10,000 starting balance)' : '' %>
            </span>
        </div>
        <button type="button" class="btn-create-account" onclick="openCreateModal()">
            + Create New Account
        </button>
    </div>

    <!-- Trading Mode Indicator (if forced by admin) -->
    <% if (account.tradingMode !== 'normal') { %>
        <div class="trading-mode-indicator <%= account.tradingMode %>">
            <span>⚡</span>
            <span>Admin Mode Active: <%= account.tradingMode.replace('_', ' ').toUpperCase() %></span>
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error"><%= error_msg %></div>
    <% } %>

    <!-- Account Info -->
    <div class="account-bar">
        <div class="account-grid">
            <div class="account-item">
                <div class="account-label"><%= account.accountType === 'demo' ? 'Demo Balance' : 'Balance' %></div>
                <div class="account-value <%= account.accountType === 'demo' ? 'demo' : '' %>">
                    <%= formatCurrency(account.balance, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Equity</div>
                <div class="account-value <%= account.equity + account.totalOpenPnL >= account.balance ? 'positive' : 'negative' %>">
                    <%= formatCurrency(account.equity + account.totalOpenPnL, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Used Margin</div>
                <div class="account-value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
            </div>
            <div class="account-item">
                <div class="account-label">Free Margin</div>
                <div class="account-value <%= account.freeMargin > 100 ? 'positive' : 'warning' %>">
                    <%= formatCurrency(account.freeMargin, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Margin Level</div>
                <div class="account-value <%= account.marginLevel > 100 ? 'positive' : account.marginLevel > 50 ? 'warning' : 'negative' %>">
                    <%= account.marginLevel.toFixed(1) %>%
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Open P&L</div>
                <div class="account-value <%= account.totalOpenPnL >= 0 ? 'positive' : 'negative' %>">
                    <%= account.totalOpenPnL >= 0 ? '+' : '' %><%= formatCurrency(account.totalOpenPnL, account.currency) %>
                </div>
            </div>
        </div>
    </div>

    <div class="trading-grid">
        <!-- Left Column: Chart & Pairs -->
        <div>
            <!-- Chart -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="pair-info">
                        <h3 id="chartPairName">Select a Pair</h3>
                        <p id="chartPairSymbol">Click a pair below to start trading</p>
                    </div>
                    <div class="price-display-main">
                        <div class="price-main" id="chartPrice">0.00000</div>
                        <div class="price-change" id="chartChange">+0.00%</div>
                    </div>
                </div>
                <div id="tradingview_chart" style="height: 400px; background: #0d0d14; border-radius: 12px;"></div>
            </div>

            <!-- Pairs Grid -->
            <div class="pairs-section">
                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; color: #f4f4f5;">Currency Pairs</h3>
                <div class="pairs-grid">
                    <% pairs.forEach(pair => { %>
                        <div class="pair-card" onclick="selectPair('<%= pair.id %>', '<%= pair.symbol %>', '<%= pair.name %>', <%= pair.bid %>, <%= pair.ask %>)">
                            <div class="pair-header">
                                <span class="pair-symbol"><%= pair.symbol %></span>
                                <span class="pair-status"></span>
                            </div>
                            <div class="pair-prices">
                                <div class="price-box">
                                    <div class="price-label-small">Bid</div>
                                    <div class="price-value-small bid" id="bid-<%= pair.symbol %>"><%= pair.bid.toFixed(5) %></div>
                                </div>
                                <div class="price-box">
                                    <div class="price-label-small">Ask</div>
                                    <div class="price-value-small ask" id="ask-<%= pair.symbol %>"><%= pair.ask.toFixed(5) %></div>
                                </div>
                            </div>
                            <div class="pair-spread">Spread: <%= (pair.spread * 10000).toFixed(1) %> pips</div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Open Positions -->
            <% if (openPositions.length > 0) { %>
            <div class="positions-section">
                <div class="section-header">
                    <h3 style="font-size: 18px; font-weight: 600; color: #f4f4f5;">Open Positions (<%= openPositions.length %>)</h3>
                </div>
                <table class="positions-table">
                    <thead>
                        <tr>
                            <th>Pair</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Entry</th>
                            <th>Current</th>
                            <th>P&L (pips)</th>
                            <th>P&L ($)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% openPositions.forEach(pos => { %>
                            <tr>
                                <td>
                                    <div class="position-pair"><%= pos.pair_symbol %></div>
                                    <div style="color: #666; font-size: 11px;"><%= pos.pair_name %></div>
                                </td>
                                <td>
                                    <span class="position-type <%= pos.direction %>"><%= pos.direction %></span>
                                </td>
                                <td class="position-price"><%= pos.lot_size %> lots</td>
                                <td class="position-price"><%= pos.entry_price.toFixed(5) %></td>
                                <td class="position-price"><%= pos.current_price ? pos.current_price.toFixed(5) : '-' %></td>
                                <td class="position-pnl <%= pos.pips_profit >= 0 ? 'positive' : 'negative' %>">
                                    <%= pos.pips_profit >= 0 ? '+' : '' %><%= pos.pips_profit ? pos.pips_profit.toFixed(1) : '0.0' %>
                                </td>
                                <td class="position-pnl <%= pos.profit_loss >= 0 ? 'positive' : 'negative' %>">
                                    <%= pos.profit_loss >= 0 ? '+' : '' %><%= formatCurrency(pos.profit_loss || 0, account.currency) %>
                                </td>
                                <td>
                                    <form action="/trading/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-close">Close</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <!-- Right Column: Trade Panel -->
        <div class="trade-panel">
            <h3 class="panel-title">New Order</h3>

            <div class="selected-pair">
                <div class="selected-pair-label">Selected Pair</div>
                <div class="selected-pair-value" id="selectedPairDisplay">--</div>
                <input type="hidden" name="pair_id" id="selectedPairId">
            </div>

            <form action="/trading/open-position" method="POST" id="tradeForm">
                <input type="hidden" name="pair_id" id="formPairId">

                <!-- Direction -->
                <div class="direction-tabs">
                    <button type="button" class="direction-tab buy active" onclick="setDirection('buy')">Buy</button>
                    <button type="button" class="direction-tab sell" onclick="setDirection('sell')">Sell</button>
                </div>
                <input type="hidden" name="direction" id="directionInput" value="buy">

                <!-- Lot Size -->
                <div class="form-group">
                    <label class="form-label">Lot Size</label>
                    <select name="lot_size" class="form-select" id="lotSize" onchange="calculateMargin()">
                        <option value="0.01">0.01 Micro (1,000 units)</option>
                        <option value="0.1">0.1 Mini (10,000 units)</option>
                        <option value="1" selected>1.0 Standard (100,000 units)</option>
                        <option value="2">2.0 (200,000 units)</option>
                        <option value="5">5.0 (500,000 units)</option>
                        <option value="10">10.0 (1,000,000 units)</option>
                    </select>
                </div>

                <!-- Leverage -->
                <div class="form-group">
                    <label class="form-label">Leverage</label>
                    <select name="leverage" class="form-select" id="leverage" onchange="calculateMargin()">
                        <option value="50">1:50</option>
                        <option value="100" selected>1:100</option>
                        <option value="200">1:200</option>
                        <option value="500">1:500</option>
                    </select>
                </div>

                <!-- Stop Loss -->
                <div class="form-group">
                    <label class="form-label">Stop Loss (optional)</label>
                    <input type="number" name="stop_loss" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Take Profit -->
                <div class="form-group">
                    <label class="form-label">Take Profit (optional)</label>
                    <input type="number" name="take_profit" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Calculations -->
                <div class="calculation-box">
                    <div class="calc-row">
                        <span class="calc-label">Contract Size:</span>
                        <span class="calc-value" id="contractSize">100,000</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Pip Value:</span>
                        <span class="calc-value" id="pipValue">$10.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Margin Required:</span>
                        <span class="calc-value" id="marginRequired">$1,000.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Min Trade:</span>
                        <span class="calc-value warning" id="minTrade">$10.00</span>
                    </div>
                </div>

                <div class="min-trade-notice">
                    <span>ℹ️</span>
                    <span>Minimum trade size is $10. Adjust lot size or leverage if needed.</span>
                </div>

                <button type="submit" class="btn-submit buy" id="submitBtn" disabled>
                    Open Position
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ==================== CREATE ACCOUNT MODAL ==================== -->
<div class="modal-overlay" id="createAccountModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title">Create New Account</h2>
            <button type="button" class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>

        <div class="modal-info">
            ℹ️ Create a new trading account. You can have multiple real and demo accounts.
        </div>

        <form action="/trading/create-account" method="POST" id="modalCreateForm">
            <!-- Account Type Selection -->
            <div class="modal-account-type">
                <div class="modal-type-option active real" data-type="real" onclick="setModalType('real')">
                    <div class="modal-type-icon">💰</div>
                    <div class="modal-type-label">REAL</div>
                    <div class="modal-type-desc">Live trading with real funds</div>
                </div>
                <div class="modal-type-option demo" data-type="demo" onclick="setModalType('demo')">
                    <div class="modal-type-icon">🎮</div>
                    <div class="modal-type-label">DEMO</div>
                    <div class="modal-type-desc">Practice with $10,000 virtual</div>
                </div>
            </div>
            <input type="hidden" name="account_type" id="modalAccountType" value="real">

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">First Name</label>
                    <input type="text" name="first_name" class="modal-form-input" placeholder="John">
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Last Name</label>
                    <input type="text" name="last_name" class="modal-form-input" placeholder="Doe">
                </div>
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label">Username *</label>
                <input type="text" name="username" class="modal-form-input" placeholder="johndoe" required>
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label">Email *</label>
                <input type="email" name="email" class="modal-form-input" placeholder="john@example.com" required>
            </div>

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">Password *</label>
                    <input type="password" name="password" class="modal-form-input" placeholder="Min 6 characters" required>
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Confirm Password *</label>
                    <input type="password" name="confirm_password" class="modal-form-input" placeholder="Repeat password" required>
                </div>
            </div>

            <div class="modal-form-group" id="modalBalanceGroup">
                <label class="modal-form-label">Initial Deposit ($)</label>
                <input type="number" name="initial_balance" class="modal-form-input" placeholder="0.00" step="0.01" value="0">
            </div>

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">Phone</label>
                    <input type="tel" name="phone" class="modal-form-input" placeholder="+1 234 567 890">
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Country</label>
                    <input type="text" name="country" class="modal-form-input" placeholder="United States">
                </div>
            </div>

            <button type="submit" class="modal-btn-submit real" id="modalSubmitBtn">
                Create Real Account
            </button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="../../js/trading.js"></script>
