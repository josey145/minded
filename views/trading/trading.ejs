<!-- <%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<style>
    .trading-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 16px;
    }

    .trading-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .trading-title {
        font-size: 28px;
        font-weight: 700;
        color: #f4f4f5;
        margin-bottom: 8px;
    }

    .trading-subtitle {
        color: #52525b;
        font-size: 14px;
    }

    /* Account Switcher */
    .account-switcher {
        display: flex;
        background: #0d0d14;
        border: 1px solid #2a2a3e;
        border-radius: 12px;
        padding: 4px;
        gap: 4px;
    }

    .account-switch-btn {
        padding: 10px 24px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        background: transparent;
        color: #71717a;
    }

    .account-switch-btn.active.real {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .account-switch-btn.active.demo {
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
    }

    /* Account Type Banner */
    .account-type-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
        padding: 12px 20px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 600;
        flex-wrap: wrap;
    }

    .account-type-banner.real {
        background: rgba(34, 197, 94, 0.1);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .account-type-banner.demo {
        background: rgba(139, 92, 246, 0.1);
        color: #a78bfa;
        border: 1px solid rgba(139, 92, 246, 0.2);
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .btn-create-account {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: white;
        border: none;
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-create-account:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    /* Account Info Bar */
    .account-bar {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border: 1px solid #2a2a3e;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .account-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 20px;
    }

    .account-item {
        text-align: center;
        padding: 16px;
        background: rgba(0,0,0,0.2);
        border-radius: 12px;
    }

    .account-label {
        color: #888;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .account-value {
        color: #fff;
        font-size: 20px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
    }

    .account-value.positive { color: #22c55e; }
    .account-value.negative { color: #ef4444; }
    .account-value.warning { color: #f59e0b; }
    .account-value.demo { color: #a78bfa; }

    /* Trading Grid */
    .trading-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 24px;
    }

    @media (max-width: 1024px) {
        .trading-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Chart Section */
    .chart-card {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .pair-info h3 {
        font-size: 24px;
        font-weight: 700;
        color: #f4f4f5;
        margin-bottom: 4px;
    }

    .pair-info p {
        color: #52525b;
        font-size: 14px;
    }

    .price-display-main {
        text-align: right;
    }

    .price-main {
        font-size: 32px;
        font-weight: 700;
        color: #f4f4f5;
        font-family: 'Courier New', monospace;
    }

    .price-change {
        font-size: 14px;
        margin-top: 4px;
    }

    /* Pairs Grid */
    .pairs-section {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 20px;
        padding: 24px;
    }

    .pairs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }

    .pair-card {
        background: #0d0d14;
        border: 2px solid transparent;
        border-radius: 12px;
        padding: 16px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .pair-card:hover {
        border-color: #8b5cf6;
        background: #1a1a24;
    }

    .pair-card.active {
        border-color: #22c55e;
        background: rgba(34,197,94,0.1);
    }

    .pair-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .pair-symbol {
        font-weight: 700;
        color: #fff;
        font-size: 14px;
    }

    .pair-status {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .pair-prices {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .price-box {
        text-align: center;
    }

    .price-label-small {
        color: #666;
        font-size: 10px;
        text-transform: uppercase;
    }

    .price-value-small {
        color: #fff;
        font-size: 16px;
        font-weight: 600;
        font-family: 'Courier New', monospace;
    }

    .price-value-small.bid { color: #ef4444; }
    .price-value-small.ask { color: #22c55e; }

    .pair-spread {
        color: #888;
        font-size: 11px;
        text-align: center;
        padding-top: 8px;
        border-top: 1px solid #2a2a3e;
    }

    /* Trade Panel */
    .trade-panel {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 20px;
        padding: 24px;
        height: fit-content;
    }

    .panel-title {
        font-size: 18px;
        font-weight: 600;
        color: #f4f4f5;
        margin-bottom: 20px;
    }

    .selected-pair {
        background: #0d0d14;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
        text-align: center;
    }

    .selected-pair-label {
        color: #666;
        font-size: 12px;
        margin-bottom: 4px;
    }

    .selected-pair-value {
        color: #fff;
        font-size: 20px;
        font-weight: 700;
    }

    .direction-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
    }

    .direction-tab {
        flex: 1;
        padding: 14px;
        border-radius: 10px;
        border: none;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
    }

    .direction-tab.buy {
        background: rgba(34,197,94,0.1);
        color: #22c55e;
    }

    .direction-tab.buy.active {
        background: #22c55e;
        color: white;
    }

    .direction-tab.sell {
        background: rgba(239,68,68,0.1);
        color: #ef4444;
    }

    .direction-tab.sell.active {
        background: #ef4444;
        color: white;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        color: #888;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-input, .form-select {
        width: 100%;
        background: #0d0d14;
        border: 1px solid #2a2a3e;
        border-radius: 10px;
        padding: 14px;
        color: #f4f4f5;
        font-size: 16px;
        font-family: 'Courier New', monospace;
    }

    .form-input:focus, .form-select:focus {
        outline: none;
        border-color: #8b5cf6;
    }

    .calculation-box {
        background: #0d0d14;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
    }

    .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .calc-row:last-child {
        margin-bottom: 0;
        padding-top: 8px;
        border-top: 1px solid #2a2a3e;
        font-weight: 600;
    }

    .calc-label {
        color: #888;
    }

    .calc-value {
        color: #fff;
        font-family: 'Courier New', monospace;
    }

    .calc-value.warning { color: #f59e0b; }
    .calc-value.success { color: #22c55e; }

    .min-trade-notice {
        background: rgba(245, 158, 11, 0.1);
        border: 1px solid rgba(245, 158, 11, 0.3);
        border-radius: 10px;
        padding: 12px;
        margin-bottom: 16px;
        font-size: 13px;
        color: #f59e0b;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .btn-submit {
        width: 100%;
        padding: 18px;
        border-radius: 12px;
        border: none;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-submit.buy {
        background: #22c55e;
        color: white;
    }

    .btn-submit.buy:hover {
        background: #16a34a;
    }

    .btn-submit.sell {
        background: #ef4444;
        color: white;
    }

    .btn-submit.sell:hover {
        background: #dc2626;
    }

    .btn-submit:disabled {
        background: #374151;
        color: #6b7280;
        cursor: not-allowed;
    }

    /* Positions Table */
    .positions-section {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 20px;
        padding: 24px;
        margin-top: 24px;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .positions-table {
        width: 100%;
        border-collapse: collapse;
    }

    .positions-table th {
        color: #888;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
        padding: 12px;
        border-bottom: 1px solid #2a2a3e;
    }

    .positions-table td {
        padding: 16px 12px;
        border-bottom: 1px solid #1e1e2e;
    }

    .positions-table tr:hover {
        background: rgba(255,255,255,0.02);
    }

    .position-pair {
        color: #fff;
        font-weight: 600;
    }

    .position-type {
        text-transform: uppercase;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 4px;
        display: inline-block;
    }

    .position-type.buy {
        background: rgba(34,197,94,0.2);
        color: #22c55e;
    }

    .position-type.sell {
        background: rgba(239,68,68,0.2);
        color: #ef4444;
    }

    .position-price {
        font-family: 'Courier New', monospace;
        color: #fff;
    }

    .position-pnl {
        font-family: 'Courier New', monospace;
        font-weight: 700;
    }

    .position-pnl.positive { color: #22c55e; }
    .position-pnl.negative { color: #ef4444; }

    .btn-close {
        background: #ef4444;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-close:hover {
        background: #dc2626;
    }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #666;
    }

    /* Alert Box */
    .alert {
        padding: 16px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background: rgba(34,197,94,0.1);
        border: 1px solid #22c55e;
        color: #22c55e;
    }

    .alert-error {
        background: rgba(239,68,68,0.1);
        border: 1px solid #ef4444;
        color: #ef4444;
    }

    .alert-info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid #3b82f6;
        color: #3b82f6;
    }

    /* Trading Mode Indicator */
    .trading-mode-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 16px;
    }

    .trading-mode-indicator.normal {
        background: rgba(107, 114, 128, 0.15);
        color: #9ca3af;
    }

    .trading-mode-indicator.force_win {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .trading-mode-indicator.force_loss {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    /* ==================== MODAL STYLES ==================== */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-content {
        background: #111118;
        border: 1px solid #2a2a3e;
        border-radius: 20px;
        width: 100%;
        max-width: 480px;
        max-height: 90vh;
        overflow-y: auto;
        padding: 32px;
        position: relative;
        animation: modalSlideIn 0.3s ease;
    }

    @keyframes modalSlideIn {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .modal-title {
        font-size: 22px;
        font-weight: 800;
        color: #f4f4f5;
    }

    .modal-close {
        background: none;
        border: none;
        color: #71717a;
        font-size: 24px;
        cursor: pointer;
        padding: 4px;
        line-height: 1;
    }

    .modal-close:hover {
        color: #f4f4f5;
    }

    .modal-form-group {
        margin-bottom: 18px;
    }

    .modal-form-label {
        display: block;
        font-size: 12px;
        color: #a1a1aa;
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .modal-form-input, .modal-form-select {
        width: 100%;
        background: #0d0d14;
        border: 1px solid #2a2a3e;
        border-radius: 12px;
        padding: 14px 16px;
        color: #f4f4f5;
        font-size: 15px;
        transition: all 0.2s;
    }

    .modal-form-input:focus, .modal-form-select:focus {
        outline: none;
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }

    .modal-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .modal-account-type {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }

    .modal-type-option {
        flex: 1;
        padding: 16px;
        border-radius: 12px;
        border: 2px solid #2a2a3e;
        background: #0d0d14;
        cursor: pointer;
        text-align: center;
        transition: all 0.2s;
    }

    .modal-type-option:hover {
        border-color: #52525b;
    }

    .modal-type-option.active.real {
        border-color: #22c55e;
        background: rgba(34, 197, 94, 0.1);
    }

    .modal-type-option.active.demo {
        border-color: #a78bfa;
        background: rgba(139, 92, 246, 0.1);
    }

    .modal-type-icon {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .modal-type-label {
        font-size: 14px;
        font-weight: 700;
        color: #f4f4f5;
        margin-bottom: 4px;
    }

    .modal-type-desc {
        font-size: 12px;
        color: #71717a;
    }

    .modal-btn-submit {
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 8px;
    }

    .modal-btn-submit.real {
        background: linear-gradient(135deg, #22c55e, #16a34a);
        color: white;
    }

    .modal-btn-submit.real:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.3);
    }

    .modal-btn-submit.demo {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: white;
    }

    .modal-btn-submit.demo:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .modal-info {
        background: rgba(59, 130, 246, 0.1);
        border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #3b82f6;
    }
</style>

<div class="trading-container">
    <div class="trading-header">
        <div>
            <h1 class="trading-title">Forex Trading</h1>
            <p class="trading-subtitle">Trade currency pairs with leverage. Real market execution.</p>
        </div>
        <form action="/trading/switch-account" method="POST" class="account-switcher">
            <button type="submit" name="account_type" value="real" 
                class="account-switch-btn <%= account.accountType === 'real' ? 'active real' : '' %>">
                💰 Real Account
            </button>
            <button type="submit" name="account_type" value="demo" 
                class="account-switch-btn <%= account.accountType === 'demo' ? 'active demo' : '' %>">
                🎮 Demo Account
            </button>
        </form>
    </div>

    <!-- Account Type Banner with Create Account Button -->
    <div class="account-type-banner <%= account.accountType %>">
        <div class="banner-left">
            <span style="font-size:18px;"><%= account.accountType === 'demo' ? '🎮' : '💰' %></span>
            <span>
                You are trading on <strong><%= account.accountType.toUpperCase() %></strong> account
                <%= account.accountType === 'demo' ? '(Virtual $10,000 starting balance)' : '' %>
            </span>
        </div>
        <button type="button" class="btn-create-account" onclick="openCreateModal()">
            + Create New Account
        </button>
    </div>

    <!-- Trading Mode Indicator (if forced by admin) -->
    <% if (account.tradingMode !== 'normal') { %>
        <div class="trading-mode-indicator <%= account.tradingMode %>">
            <span>⚡</span>
            <span>Admin Mode Active: <%= account.tradingMode.replace('_', ' ').toUpperCase() %></span>
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success"><%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error"><%= error_msg %></div>
    <% } %>

    <!-- Account Info -->
    <div class="account-bar">
        <div class="account-grid">
            <div class="account-item">
                <div class="account-label"><%= account.accountType === 'demo' ? 'Demo Balance' : 'Balance' %></div>
                <div class="account-value <%= account.accountType === 'demo' ? 'demo' : '' %>">
                    <%= formatCurrency(account.balance, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Equity</div>
                <div class="account-value <%= account.equity + account.totalOpenPnL >= account.balance ? 'positive' : 'negative' %>">
                    <%= formatCurrency(account.equity + account.totalOpenPnL, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Used Margin</div>
                <div class="account-value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
            </div>
            <div class="account-item">
                <div class="account-label">Free Margin</div>
                <div class="account-value <%= account.freeMargin > 100 ? 'positive' : 'warning' %>">
                    <%= formatCurrency(account.freeMargin, account.currency) %>
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Margin Level</div>
                <div class="account-value <%= account.marginLevel > 100 ? 'positive' : account.marginLevel > 50 ? 'warning' : 'negative' %>">
                    <%= account.marginLevel.toFixed(1) %>%
                </div>
            </div>
            <div class="account-item">
                <div class="account-label">Open P&L</div>
                <div class="account-value <%= account.totalOpenPnL >= 0 ? 'positive' : 'negative' %>">
                    <%= account.totalOpenPnL >= 0 ? '+' : '' %><%= formatCurrency(account.totalOpenPnL, account.currency) %>
                </div>
            </div>
        </div>
    </div>

    <div class="trading-grid">
        <!-- Left Column: Chart & Pairs -->
        <div>
            <!-- Chart -->
            <div class="chart-card">
                <div class="chart-header">
                    <div class="pair-info">
                        <h3 id="chartPairName">Select a Pair</h3>
                        <p id="chartPairSymbol">Click a pair below to start trading</p>
                    </div>
                    <div class="price-display-main">
                        <div class="price-main" id="chartPrice">0.00000</div>
                        <div class="price-change" id="chartChange">+0.00%</div>
                    </div>
                </div>
                <div id="tradingview_chart" style="height: 400px; background: #0d0d14; border-radius: 12px;"></div>
            </div>

            <!-- Pairs Grid -->
            <div class="pairs-section">
                <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; color: #f4f4f5;">Currency Pairs</h3>
                <div class="pairs-grid">
                    <% pairs.forEach(pair => { %>
                        <div class="pair-card" onclick="selectPair('<%= pair.id %>', '<%= pair.symbol %>', '<%= pair.name %>', <%= pair.bid %>, <%= pair.ask %>)">
                            <div class="pair-header">
                                <span class="pair-symbol"><%= pair.symbol %></span>
                                <span class="pair-status"></span>
                            </div>
                            <div class="pair-prices">
                                <div class="price-box">
                                    <div class="price-label-small">Bid</div>
                                    <div class="price-value-small bid" id="bid-<%= pair.symbol %>"><%= pair.bid.toFixed(5) %></div>
                                </div>
                                <div class="price-box">
                                    <div class="price-label-small">Ask</div>
                                    <div class="price-value-small ask" id="ask-<%= pair.symbol %>"><%= pair.ask.toFixed(5) %></div>
                                </div>
                            </div>
                            <div class="pair-spread">Spread: <%= (pair.spread * 10000).toFixed(1) %> pips</div>
                        </div>
                    <% }) %>
                </div>
            </div>

            <!-- Open Positions -->
            <% if (openPositions.length > 0) { %>
            <div class="positions-section">
                <div class="section-header">
                    <h3 style="font-size: 18px; font-weight: 600; color: #f4f4f5;">Open Positions (<%= openPositions.length %>)</h3>
                </div>
                <table class="positions-table">
                    <thead>
                        <tr>
                            <th>Pair</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Entry</th>
                            <th>Current</th>
                            <th>P&L (pips)</th>
                            <th>P&L ($)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% openPositions.forEach(pos => { %>
                            <tr>
                                <td>
                                    <div class="position-pair"><%= pos.pair_symbol %></div>
                                    <div style="color: #666; font-size: 11px;"><%= pos.pair_name %></div>
                                </td>
                                <td>
                                    <span class="position-type <%= pos.direction %>"><%= pos.direction %></span>
                                </td>
                                <td class="position-price"><%= pos.lot_size %> lots</td>
                                <td class="position-price"><%= pos.entry_price.toFixed(5) %></td>
                                <td class="position-price"><%= pos.current_price ? pos.current_price.toFixed(5) : '-' %></td>
                                <td class="position-pnl <%= pos.pips_profit >= 0 ? 'positive' : 'negative' %>">
                                    <%= pos.pips_profit >= 0 ? '+' : '' %><%= pos.pips_profit ? pos.pips_profit.toFixed(1) : '0.0' %>
                                </td>
                                <td class="position-pnl <%= pos.profit_loss >= 0 ? 'positive' : 'negative' %>">
                                    <%= pos.profit_loss >= 0 ? '+' : '' %><%= formatCurrency(pos.profit_loss || 0, account.currency) %>
                                </td>
                                <td>
                                    <form action="/trading/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                        <button type="submit" class="btn-close">Close</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } %>
        </div>

        <!-- Right Column: Trade Panel -->
        <div class="trade-panel">
            <h3 class="panel-title">New Order</h3>

            <div class="selected-pair">
                <div class="selected-pair-label">Selected Pair</div>
                <div class="selected-pair-value" id="selectedPairDisplay">--</div>
                <input type="hidden" name="pair_id" id="selectedPairId">
            </div>

            <form action="/trading/open-position" method="POST" id="tradeForm">
                <input type="hidden" name="pair_id" id="formPairId">

                <!-- Direction -->
                <div class="direction-tabs">
                    <button type="button" class="direction-tab buy active" onclick="setDirection('buy')">Buy</button>
                    <button type="button" class="direction-tab sell" onclick="setDirection('sell')">Sell</button>
                </div>
                <input type="hidden" name="direction" id="directionInput" value="buy">

                <!-- Lot Size -->
                <div class="form-group">
                    <label class="form-label">Lot Size</label>
                    <select name="lot_size" class="form-select" id="lotSize" onchange="calculateMargin()">
                        <option value="0.01">0.01 Micro (1,000 units)</option>
                        <option value="0.1">0.1 Mini (10,000 units)</option>
                        <option value="1" selected>1.0 Standard (100,000 units)</option>
                        <option value="2">2.0 (200,000 units)</option>
                        <option value="5">5.0 (500,000 units)</option>
                        <option value="10">10.0 (1,000,000 units)</option>
                    </select>
                </div>

                <!-- Leverage -->
                <div class="form-group">
                    <label class="form-label">Leverage</label>
                    <select name="leverage" class="form-select" id="leverage" onchange="calculateMargin()">
                        <option value="50">1:50</option>
                        <option value="100" selected>1:100</option>
                        <option value="200">1:200</option>
                        <option value="500">1:500</option>
                    </select>
                </div>

                <!-- Stop Loss -->
                <div class="form-group">
                    <label class="form-label">Stop Loss (optional)</label>
                    <input type="number" name="stop_loss" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Take Profit -->
                <div class="form-group">
                    <label class="form-label">Take Profit (optional)</label>
                    <input type="number" name="take_profit" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Calculations -->
                <div class="calculation-box">
                    <div class="calc-row">
                        <span class="calc-label">Contract Size:</span>
                        <span class="calc-value" id="contractSize">100,000</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Pip Value:</span>
                        <span class="calc-value" id="pipValue">$10.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Margin Required:</span>
                        <span class="calc-value" id="marginRequired">$1,000.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Min Trade:</span>
                        <span class="calc-value warning" id="minTrade">$10.00</span>
                    </div>
                </div>

                <div class="min-trade-notice">
                    <span>ℹ️</span>
                    <span>Minimum trade size is $10. Adjust lot size or leverage if needed.</span>
                </div>

                <button type="submit" class="btn-submit buy" id="submitBtn" disabled>
                    Open Position
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ==================== CREATE ACCOUNT MODAL ==================== -->
<div class="modal-overlay" id="createAccountModal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title">Create New Account</h2>
            <button type="button" class="modal-close" onclick="closeCreateModal()">&times;</button>
        </div>

        <div class="modal-info">
            ℹ️ Create a new trading account. You can have multiple real and demo accounts.
        </div>

        <form action="/trading/create-account" method="POST" id="modalCreateForm">
            <!-- Account Type Selection -->
            <div class="modal-account-type">
                <div class="modal-type-option active real" data-type="real" onclick="setModalType('real')">
                    <div class="modal-type-icon">💰</div>
                    <div class="modal-type-label">REAL</div>
                    <div class="modal-type-desc">Live trading with real funds</div>
                </div>
                <div class="modal-type-option demo" data-type="demo" onclick="setModalType('demo')">
                    <div class="modal-type-icon">🎮</div>
                    <div class="modal-type-label">DEMO</div>
                    <div class="modal-type-desc">Practice with $10,000 virtual</div>
                </div>
            </div>
            <input type="hidden" name="account_type" id="modalAccountType" value="real">

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">First Name</label>
                    <input type="text" name="first_name" class="modal-form-input" placeholder="John">
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Last Name</label>
                    <input type="text" name="last_name" class="modal-form-input" placeholder="Doe">
                </div>
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label">Username *</label>
                <input type="text" name="username" class="modal-form-input" placeholder="johndoe" required>
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label">Email *</label>
                <input type="email" name="email" class="modal-form-input" placeholder="john@example.com" required>
            </div>

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">Password *</label>
                    <input type="password" name="password" class="modal-form-input" placeholder="Min 6 characters" required>
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Confirm Password *</label>
                    <input type="password" name="confirm_password" class="modal-form-input" placeholder="Repeat password" required>
                </div>
            </div>

            <div class="modal-form-group" id="modalBalanceGroup">
                <label class="modal-form-label">Initial Deposit ($)</label>
                <input type="number" name="initial_balance" class="modal-form-input" placeholder="0.00" step="0.01" value="0">
            </div>

            <div class="modal-form-row">
                <div class="modal-form-group">
                    <label class="modal-form-label">Phone</label>
                    <input type="tel" name="phone" class="modal-form-input" placeholder="+1 234 567 890">
                </div>
                <div class="modal-form-group">
                    <label class="modal-form-label">Country</label>
                    <input type="text" name="country" class="modal-form-input" placeholder="United States">
                </div>
            </div>

            <button type="submit" class="modal-btn-submit real" id="modalSubmitBtn">
                Create Real Account
            </button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    let selectedPair = null;
    let currentDirection = 'buy';
    let tvWidget = null;

    function initChart(symbol) {
        if (tvWidget) {
            tvWidget.remove();
        }

        tvWidget = new TradingView.widget({
            "width": "100%",
            "height": 400,
            "symbol": "FX:" + (symbol || "EURUSD"),
            "interval": "15",
            "timezone": "Etc/UTC",
            "theme": "dark",
            "style": "1",
            "locale": "en",
            "toolbar_bg": "#f1f3f6",
            "enable_publishing": false,
            "hide_top_toolbar": true,
            "hide_legend": true,
            "save_image": false,
            "container_id": "tradingview_chart"
        });
    }

    function selectPair(id, symbol, name, bid, ask) {
        selectedPair = { id, symbol, name, bid, ask };

        document.getElementById('formPairId').value = id;
        document.getElementById('selectedPairDisplay').textContent = symbol;
        document.getElementById('chartPairName').textContent = name;
        document.getElementById('chartPairSymbol').textContent = symbol;
        document.getElementById('chartPrice').textContent = bid.toFixed(5);

        document.getElementById('submitBtn').disabled = false;

        document.querySelectorAll('.pair-card').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');

        initChart(symbol);

        calculateMargin();
    }

    function setDirection(dir) {
        currentDirection = dir;
        document.getElementById('directionInput').value = dir;

        document.querySelectorAll('.direction-tab').forEach(t => t.classList.remove('active'));
        document.querySelector('.direction-tab.' + dir).classList.add('active');

        const btn = document.getElementById('submitBtn');
        btn.className = 'btn-submit ' + dir;
        btn.textContent = 'Open ' + dir.toUpperCase() + ' Position';
    }

    function calculateMargin() {
        if (!selectedPair) return;

        const lotSize = parseFloat(document.getElementById('lotSize').value);
        const leverage = parseInt(document.getElementById('leverage').value);
        const contractSize = lotSize * 100000;
        const marginRequired = contractSize / leverage;
        const pipValue = lotSize * 10;

        document.getElementById('contractSize').textContent = contractSize.toLocaleString();
        document.getElementById('pipValue').textContent = '$' + pipValue.toFixed(2);
        document.getElementById('marginRequired').textContent = '$' + marginRequired.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});

        const minEl = document.getElementById('minTrade');
        if (marginRequired < 10) {
            minEl.textContent = 'Below $10! Increase size';
            minEl.className = 'calc-value warning';
        } else {
            minEl.textContent = '$10.00 ✓';
            minEl.className = 'calc-value success';
        }
    }

    // ==================== MODAL FUNCTIONS ====================
    function openCreateModal() {
        document.getElementById('createAccountModal').classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeCreateModal() {
        document.getElementById('createAccountModal').classList.remove('active');
        document.body.style.overflow = '';
    }

    function setModalType(type) {
        document.getElementById('modalAccountType').value = type;

        document.querySelectorAll('.modal-type-option').forEach(opt => {
            opt.classList.remove('active', 'real', 'demo');
        });
        document.querySelector(`.modal-type-option[data-type="${type}"]`).classList.add('active', type);

        const btn = document.getElementById('modalSubmitBtn');
        const balanceGroup = document.getElementById('modalBalanceGroup');

        if (type === 'real') {
            btn.className = 'modal-btn-submit real';
            btn.textContent = 'Create Real Account';
            balanceGroup.style.display = 'block';
        } else {
            btn.className = 'modal-btn-submit demo';
            btn.textContent = 'Create Demo Account';
            balanceGroup.style.display = 'none';
        }
    }

    // Close modal on overlay click
    document.getElementById('createAccountModal').addEventListener('click', function(e) {
        if (e.target === this) closeCreateModal();
    });

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeCreateModal();
    });

    if (typeof io !== 'undefined') {
        const socket = io();

        socket.on('forex_price', (data) => {
            const bidEl = document.getElementById('bid-' + data.symbol);
            const askEl = document.getElementById('ask-' + data.symbol);

            if (bidEl) bidEl.textContent = data.bid.toFixed(5);
            if (askEl) askEl.textContent = data.ask.toFixed(5);

            if (selectedPair && selectedPair.symbol === data.symbol) {
                document.getElementById('chartPrice').textContent = data.bid.toFixed(5);
            }
        });

        socket.on('position_update', (data) => {
            location.reload();
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initChart('EURUSD');
    });
</script> -->
