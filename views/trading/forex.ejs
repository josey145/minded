<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="../../css/forex.css">

<!-- Top Bar -->
<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" onclick="toggleSidebar()" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
        <a href="/dashboard" class="brand">
            <i class="fas fa-chart-line"></i> TRUST-FX
        </a>
    </div>
    <div class="topbar-right">
        <div class="balance-chip">
            <i class="fas fa-wallet"></i>
            <span><%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %></span>
        </div>
        <form action="/trading/switch-account" method="POST" class="account-switcher-top">
            <button type="submit" name="account_type" value="real" 
                class="btn-real <%= account && account.accountType === 'real' ? 'active' : '' %>">
                <i class="fas fa-wallet"></i> <span>Real</span>
            </button>
            <button type="submit" name="account_type" value="demo" 
                class="btn-demo <%= account && account.accountType === 'demo' ? 'active' : '' %>">
                <i class="fas fa-gamepad"></i> <span>Demo</span>
            </button>
        </form>
        <div class="user-avatar" title="<%= userData && userData.username ? userData.username : 'User' %>">
            <%= userData && userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %>
        </div>
    </div>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-section">
        <div class="sidebar-title">Menu</div>
        <nav class="sidebar-nav">
            <a href="/trading" class="sidebar-link active">
                <i class="fas fa-chart-line"></i> Trading
            </a>
            <a href="/trading/positions" class="sidebar-link">
                <i class="fas fa-list"></i> Positions
            </a>
            <a href="/transactions/history" class="sidebar-link">
                <i class="fas fa-history"></i> History
            </a>
            <a href="/investments" class="sidebar-link">
                <i class="fas fa-wallet"></i> Deposit
            </a>
            <a href="/transactions/withdraw/verify" class="sidebar-link">
                <i class="fas fa-university"></i> Withdraw
            </a>
        </nav>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
        <div class="sidebar-title">Account</div>
        <nav class="sidebar-nav">
            <a href="/profile/settings" class="sidebar-link">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
</aside>

<!-- Main Content -->
<main class="main-content">
    <!-- Admin Mode Badge -->
    <% if (account && account.userRole === 'admin' && account.tradingMode !== 'normal') { %>
        <div class="admin-badge <%= account.tradingMode %>">
            <i class="fas fa-bolt"></i>
            <span>Admin Mode: <%= account.tradingMode.replace('_', ' ').toUpperCase() %></span>
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
        </div>
    <% } %>

    <!-- Currency Pairs Ticker Bar -->
    <div class="pairs-ticker" id="pairsTicker">
        <% if (pairs && pairs.length > 0) { %>
            <% pairs.forEach(pair => { %>
                <div class="ticker-item" onclick="selectPair('<%= pair.id %>', '<%= pair.symbol %>', '<%= pair.name %>', <%= pair.bid %>, <%= pair.ask %>, <%= pair.change_24h || 0 %>)">
                    <div class="ticker-symbol"><%= pair.symbol %></div>
                    <div class="ticker-price <%= (pair.change_24h || 0) >= 0 ? 'up' : 'down' %>" id="price-<%= pair.symbol %>">
                        <%= pair.bid.toFixed(5) %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="color: var(--text-muted); font-size: 13px; padding: 8px;">No pairs available</div>
        <% } %>
    </div>

    <!-- Trading Terminal -->
    <div class="terminal-grid">
        <!-- Left: Chart -->
        <div class="chart-section">
            <div class="chart-header-card">
                <div class="chart-info">
                    <h2 id="chartPairName">Select a Pair</h2>
                    <p id="chartPairSymbol">Click a pair above to start trading</p>
                </div>
                <div class="chart-price-display">
                    <div class="chart-price-main" id="chartPrice">--</div>
                    <div class="chart-price-change" id="chartChange">--</div>
                </div>
            </div>
            <div class="chart-container" id="tradingview_chart">
                <div class="empty-trade-state">
                    <i class="fas fa-chart-area"></i>
                    <h4>Ready to Trade</h4>
                    <p>Select a currency pair from the ticker bar above to view the live chart and start trading.</p>
                </div>
            </div>
        </div>

        <!-- Right: Trade Panel -->
        <div class="trade-panel">
            <div class="trade-panel-header">
                <h3><i class="fas fa-handshake" style="color: var(--accent-purple);"></i> New Order</h3>
            </div>

            <% if (!pairs || pairs.length === 0) { %>
                <div class="empty-trade-state">
                    <i class="fas fa-coins"></i>
                    <h4>No Trading Pairs</h4>
                    <p>Currency pairs are currently unavailable. Please check back later.</p>
                </div>
            <% } else { %>
                <div class="selected-pair-display">
                    <div class="label">Selected Pair</div>
                    <div class="value" id="selectedPairSymbol">--</div>
                    <div class="sub" id="selectedPairName">Select a pair to trade</div>
                </div>

                <form action="/trading/open-position" method="POST" id="tradeForm">
                    <input type="hidden" name="pair_id" id="formPairId">
                    <input type="hidden" name="direction" id="directionInput" value="buy">

                    <!-- Direction Buttons -->
                    <div class="direction-buttons">
                        <button type="button" class="direction-btn buy active" onclick="setDirection('buy')">
                            <i class="fas fa-arrow-up"></i>
                            <span>Buy</span>
                        </button>
                        <button type="button" class="direction-btn sell" onclick="setDirection('sell')">
                            <i class="fas fa-arrow-down"></i>
                            <span>Sell</span>
                        </button>
                    </div>

                    <!-- Trade Amount -->
                    <div class="form-group">
                        <label style="display: block; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">
                            <i class="fas fa-dollar-sign"></i> Trade Amount
                        </label>
                        <div class="amount-input-group">
                            <span class="currency-label">$</span>
                            <input type="number" name="trade_amount" class="amount-input" id="tradeAmount" 
                                placeholder="Enter amount" step="0.01" min="0.01" oninput="calculateTrade()" required>
                        </div>
                        <div class="amount-presets" style="margin-top: 8px;">
                            <button type="button" class="preset-btn" onclick="setAmount(10)">$10</button>
                            <button type="button" class="preset-btn" onclick="setAmount(50)">$50</button>
                            <button type="button" class="preset-btn" onclick="setAmount(100)">$100</button>
                            <button type="button" class="preset-btn" onclick="setAmount(500)">$500</button>
                            <button type="button" class="preset-btn" onclick="setAmount(1000)">$1K</button>
                        </div>
                    </div>

                    <!-- Leverage -->
                    <div class="form-group">
                        <label style="display: block; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">
                            <i class="fas fa-layer-group"></i> Leverage
                        </label>
                        <select name="leverage" class="leverage-select" id="leverage" onchange="calculateTrade()">
                            <option value="1">1:1 (No Leverage)</option>
                            <option value="10">1:10</option>
                            <option value="50">1:50</option>
                            <option value="100" selected>1:100</option>
                            <option value="200">1:200</option>
                            <option value="500">1:500</option>
                        </select>
                    </div>

                    <!-- Calculations -->
                    <div class="calc-box">
                        <div class="calc-row">
                            <span class="calc-label">Position Size:</span>
                            <span class="calc-value" id="positionSize">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Margin Required:</span>
                            <span class="calc-value" id="marginRequired">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Pip Value:</span>
                            <span class="calc-value" id="pipValue">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Available Balance:</span>
                            <span class="calc-value highlight" id="availableBalance">
                                <%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %>
                            </span>
                        </div>
                    </div>

                    <!-- Execute Button -->
                    <button type="submit" class="btn-execute buy" id="submitBtn" disabled>
                        <i class="fas fa-lock"></i> Select a Pair First
                    </button>
                </form>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    let selectedPair = null;
    let currentDirection = 'buy';
    let tvWidget = null;
    const userBalance = <%= account && account.balance ? account.balance : 0 %>;

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('active');
    }

    function initChart(symbol) {
        const container = document.getElementById('tradingview_chart');
        container.innerHTML = ''; // Clear empty state

        if (tvWidget) {
            tvWidget.remove();
        }

        tvWidget = new TradingView.widget({
            "width": "100%",
            "height": "100%",
            "symbol": "FX:" + (symbol || "EURUSD"),
            "interval": "15",
            "timezone": "Etc/UTC",
            "theme": "dark",
            "style": "1",
            "locale": "en",
            "toolbar_bg": "#f1f3f6",
            "enable_publishing": false,
            "hide_top_toolbar": true,
            "hide_legend": true,
            "save_image": false,
            "container_id": "tradingview_chart"
        });
    }

    function selectPair(id, symbol, name, bid, ask, change24h) {
        selectedPair = { id, symbol, name, bid, ask };

        // Update form
        document.getElementById('formPairId').value = id;
        document.getElementById('selectedPairSymbol').textContent = symbol;
        document.getElementById('selectedPairName').textContent = name;

        // Update chart header
        document.getElementById('chartPairName').textContent = name;
        document.getElementById('chartPairSymbol').textContent = symbol;
        document.getElementById('chartPrice').textContent = bid.toFixed(5);

        const changeEl = document.getElementById('chartChange');
        if (change24h >= 0) {
            changeEl.innerHTML = '<i class="fas fa-arrow-up"></i> +' + change24h.toFixed(2) + '%';
            changeEl.className = 'chart-price-change up';
        } else {
            changeEl.innerHTML = '<i class="fas fa-arrow-down"></i> ' + change24h.toFixed(2) + '%';
            changeEl.className = 'chart-price-change down';
        }

        // Enable submit button
        const btn = document.getElementById('submitBtn');
        btn.disabled = false;
        updateSubmitButton();

        // Highlight active ticker
        document.querySelectorAll('.ticker-item').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');

        // Init chart
        initChart(symbol);
        calculateTrade();
    }

    function setDirection(dir) {
        currentDirection = dir;
        document.getElementById('directionInput').value = dir;

        document.querySelectorAll('.direction-btn').forEach(t => t.classList.remove('active'));
        document.querySelector('.direction-btn.' + dir).classList.add('active');

        updateSubmitButton();
    }

    function setAmount(amount) {
        document.getElementById('tradeAmount').value = amount;
        calculateTrade();
    }

    function calculateTrade() {
        if (!selectedPair) return;

        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;
        const leverage = parseInt(document.getElementById('leverage').value) || 1;

        // Calculate position size based on amount and leverage
        // Amount = margin, Position Size = Amount * Leverage
        const positionSize = amount * leverage;
        const marginRequired = amount; // The amount entered is the margin
        const pipValue = (positionSize / 100000) * 10; // Approximate pip value

        document.getElementById('positionSize').textContent = '$' + positionSize.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('marginRequired').textContent = '$' + marginRequired.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('pipValue').textContent = '$' + pipValue.toFixed(2);

        // Check if user has enough balance
        const marginEl = document.getElementById('marginRequired');
        if (amount > userBalance) {
            marginEl.style.color = 'var(--accent-red)';
        } else {
            marginEl.style.color = '#fff';
        }

        updateSubmitButton();
    }

    function updateSubmitButton() {
        const btn = document.getElementById('submitBtn');
        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;

        if (!selectedPair) {
            btn.className = 'btn-execute buy';
            btn.innerHTML = '<i class="fas fa-lock"></i> Select a Pair First';
            btn.disabled = true;
            return;
        }

        if (amount <= 0) {
            btn.className = 'btn-execute ' + currentDirection;
            btn.innerHTML = '<i class="fas fa-lock"></i> Enter Amount';
            btn.disabled = true;
            return;
        }

        if (amount > userBalance) {
            btn.className = 'btn-execute ' + currentDirection;
            btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Insufficient Balance';
            btn.disabled = true;
            return;
        }

        btn.className = 'btn-execute ' + currentDirection;
        btn.innerHTML = currentDirection === 'buy'
            ? '<i class="fas fa-arrow-up"></i> Buy ' + selectedPair.symbol
            : '<i class="fas fa-arrow-down"></i> Sell ' + selectedPair.symbol;
        btn.disabled = false;
    }

    // Socket.io for live price updates
    if (typeof io !== 'undefined') {
        const socket = io();

        socket.on('forex_price', (data) => {
            const priceEl = document.getElementById('price-' + data.symbol);
            if (priceEl) {
                priceEl.textContent = data.bid.toFixed(5);
                // Flash effect
                priceEl.style.transition = 'none';
                priceEl.style.color = data.bid > parseFloat(priceEl.dataset.lastPrice || 0) ? 'var(--accent-green)' : 'var(--accent-red)';
                priceEl.dataset.lastPrice = data.bid;
                setTimeout(() => {
                    priceEl.style.transition = 'color 0.5s';
                    priceEl.style.color = '';
                }, 300);
            }

            if (selectedPair && selectedPair.symbol === data.symbol) {
                document.getElementById('chartPrice').textContent = data.bid.toFixed(5);
            }
        });

        socket.on('position_update', (data) => {
            location.reload();
        });
    }

    // Form validation before submit
    document.getElementById('tradeForm').addEventListener('submit', function(e) {
        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;
        if (amount <= 0) {
            e.preventDefault();
            alert('Please enter a valid trade amount.');
            return;
        }
        if (amount > userBalance) {
            e.preventDefault();
            alert('Insufficient balance for this trade.');
            return;
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        // No auto-init chart - wait for user to select a pair
    });
</script>