<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
        --bg-primary: #0a0e1a;
        --bg-secondary: #111827;
        --bg-card: #0f172a;
        --bg-hover: #1e293b;
        --border-color: #1e293b;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --accent-green: #22c55e;
        --accent-green-dark: #16a34a;
        --accent-red: #ef4444;
        --accent-red-dark: #dc2626;
        --accent-blue: #3b82f6;
        --accent-purple: #a78bfa;
        --accent-orange: #f59e0b;
        --sidebar-width: 240px;
        --topbar-height: 56px;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    /* ========== TOP BAR ========== */
    .topbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--topbar-height);
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        z-index: 1000;
    }

    .topbar-left { display: flex; align-items: center; gap: 12px; }

    .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: var(--text-secondary);
        font-size: 20px;
        cursor: pointer;
        padding: 8px;
        width: 40px; height: 40px;
        border-radius: 8px;
        transition: background 0.2s;
    }
    .menu-toggle:hover { background: var(--bg-hover); }

    .brand {
        font-size: 18px;
        font-weight: 800;
        color: var(--accent-green);
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .topbar-right { display: flex; align-items: center; gap: 12px; }

    .balance-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--bg-card);
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
    }
    .balance-chip i { color: var(--accent-green); font-size: 14px; }
    .balance-chip span {
        font-weight: 700;
        color: var(--accent-green);
        font-family: 'Courier New', monospace;
        font-size: 14px;
    }

    .account-switcher-top { display: flex; gap: 6px; }

    .account-switcher-top button {
        padding: 6px 14px;
        border-radius: 8px;
        border: none;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .btn-real {
        background: rgba(34, 197, 94, 0.15);
        color: var(--accent-green);
        border: 1px solid rgba(34, 197, 94, 0.3) !important;
    }
    .btn-real:hover { background: rgba(34, 197, 94, 0.25); }

    .btn-demo {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color) !important;
    }
    .btn-demo:hover {
        background: rgba(139, 92, 246, 0.1);
        color: var(--accent-purple);
        border-color: rgba(139, 92, 246, 0.3) !important;
    }
    .btn-demo.active {
        background: rgba(139, 92, 246, 0.15);
        color: var(--accent-purple);
        border-color: rgba(139, 92, 246, 0.3) !important;
    }

    .user-avatar {
        width: 32px; height: 32px;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: white;
        font-size: 13px;
        cursor: pointer;
        flex-shrink: 0;
    }

    /* ========== SIDEBAR ========== */
    .sidebar {
        position: fixed;
        top: var(--topbar-height); left: 0;
        width: var(--sidebar-width);
        height: calc(100vh - var(--topbar-height));
        background: var(--bg-card);
        border-right: 1px solid var(--border-color);
        padding: 16px 0;
        overflow-y: auto;
        z-index: 999;
        transition: transform 0.3s ease;
    }

    .sidebar-section { padding: 0 12px 16px; }
    .sidebar-title {
        font-size: 10px;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 1px;
        margin-bottom: 10px;
        font-weight: 600;
    }
    .sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
    .sidebar-link {
        padding: 10px 14px;
        border-radius: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: none;
        width: 100%;
        font-size: 14px;
        text-align: left;
    }
    .sidebar-link:hover { background: var(--bg-hover); color: var(--text-primary); }
    .sidebar-link.active { background: rgba(34, 197, 94, 0.1); color: var(--accent-green); font-weight: 600; }
    .sidebar-link i { width: 20px; text-align: center; font-size: 15px; }
    .sidebar-divider { height: 1px; background: var(--border-color); margin: 10px 12px; }

    /* ========== MAIN CONTENT ========== */
    .main-content {
        margin-left: var(--sidebar-width);
        margin-top: var(--topbar-height);
        padding: 20px;
        min-height: calc(100vh - var(--topbar-height));
    }

    /* ========== PAIRS TICKER BAR ========== */
    .pairs-ticker {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding: 12px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 16px;
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
    }
    .pairs-ticker::-webkit-scrollbar { height: 4px; }
    .pairs-ticker::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 2px; }

    .ticker-item {
        flex-shrink: 0;
        background: var(--bg-card);
        border: 2px solid transparent;
        border-radius: 10px;
        padding: 10px 16px;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 140px;
        text-align: center;
    }
    .ticker-item:hover { border-color: var(--accent-purple); background: var(--bg-hover); }
    .ticker-item.active { border-color: var(--accent-green); background: rgba(34, 197, 94, 0.08); }
    .ticker-symbol { font-weight: 700; font-size: 14px; color: #fff; margin-bottom: 4px; }
    .ticker-price { font-family: 'Courier New', monospace; font-size: 13px; font-weight: 600; }
    .ticker-price.up { color: var(--accent-green); }
    .ticker-price.down { color: var(--accent-red); }

    /* ========== TRADING TERMINAL LAYOUT ========== */
    .terminal-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 16px;
        height: calc(100vh - var(--topbar-height) - 140px);
        min-height: 500px;
    }

    /* ========== CHART AREA ========== */
    .chart-section {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .chart-header-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .chart-info h2 { font-size: 20px; margin: 0; color: var(--text-primary); }
    .chart-info p { margin: 2px 0 0; color: var(--text-muted); font-size: 12px; }

    .chart-price-display {
        text-align: right;
    }
    .chart-price-main {
        font-size: 28px;
        font-weight: 800;
        font-family: 'Courier New', monospace;
        color: var(--text-primary);
    }
    .chart-price-change {
        font-size: 13px;
        font-weight: 600;
    }
    .chart-price-change.up { color: var(--accent-green); }
    .chart-price-change.down { color: var(--accent-red); }

    .chart-container {
        flex: 1;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 12px;
        min-height: 300px;
    }

    /* ========== TRADE PANEL ========== */
    .trade-panel {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        overflow-y: auto;
    }

    .trade-panel-header {
        text-align: center;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
    }
    .trade-panel-header h3 { margin: 0; font-size: 16px; color: var(--text-primary); }

    .selected-pair-display {
        background: var(--bg-card);
        border-radius: 10px;
        padding: 14px;
        text-align: center;
    }
    .selected-pair-display .label { font-size: 11px; color: var(--text-muted); margin-bottom: 4px; }
    .selected-pair-display .value { font-size: 22px; font-weight: 700; color: #fff; }
    .selected-pair-display .sub { font-size: 12px; color: var(--text-secondary); margin-top: 4px; }

    /* Direction Buttons */
    .direction-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .direction-btn {
        padding: 16px;
        border-radius: 12px;
        border: none;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        letter-spacing: 0.5px;
    }
    .direction-btn i { font-size: 20px; }

    .direction-btn.buy {
        background: rgba(34, 197, 94, 0.1);
        color: var(--accent-green);
        border: 2px solid rgba(34, 197, 94, 0.3);
    }
    .direction-btn.buy:hover, .direction-btn.buy.active {
        background: var(--accent-green);
        color: white;
        border-color: var(--accent-green);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(34, 197, 94, 0.3);
    }

    .direction-btn.sell {
        background: rgba(239, 68, 68, 0.1);
        color: var(--accent-red);
        border: 2px solid rgba(239, 68, 68, 0.3);
    }
    .direction-btn.sell:hover, .direction-btn.sell.active {
        background: var(--accent-red);
        color: white;
        border-color: var(--accent-red);
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3);
    }

    /* Custom Amount Input */
    .amount-input-group {
        position: relative;
    }

    .amount-input-group .currency-label {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
        pointer-events: none;
    }

    .amount-input {
        width: 100%;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 14px 14px 14px 32px;
        color: var(--text-primary);
        font-size: 18px;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        transition: border-color 0.2s;
    }
    .amount-input:focus {
        outline: none;
        border-color: var(--accent-purple);
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1);
    }
    .amount-input::placeholder { color: var(--text-muted); font-weight: 400; }

    .amount-presets {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .preset-btn {
        padding: 6px 12px;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        color: var(--text-secondary);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .preset-btn:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
        border-color: var(--accent-purple);
    }

    /* Leverage */
    .leverage-select {
        width: 100%;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 12px 14px;
        color: var(--text-primary);
        font-size: 14px;
        cursor: pointer;
    }
    .leverage-select:focus { outline: none; border-color: var(--accent-purple); }

    /* Calculation Box */
    .calc-box {
        background: var(--bg-card);
        border-radius: 10px;
        padding: 14px;
    }
    .calc-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 12px;
    }
    .calc-row:last-child { margin-bottom: 0; padding-top: 8px; border-top: 1px solid var(--border-color); }
    .calc-label { color: var(--text-muted); }
    .calc-value { color: #fff; font-family: 'Courier New', monospace; font-weight: 600; }
    .calc-value.highlight { color: var(--accent-green); }

    /* Submit Button */
    .btn-execute {
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        border: none;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: auto;
    }

    .btn-execute.buy {
        background: linear-gradient(135deg, var(--accent-green), var(--accent-green-dark));
        color: white;
        box-shadow: 0 4px 16px rgba(34, 197, 94, 0.3);
    }
    .btn-execute.buy:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(34, 197, 94, 0.4);
    }

    .btn-execute.sell {
        background: linear-gradient(135deg, var(--accent-red), var(--accent-red-dark));
        color: white;
        box-shadow: 0 4px 16px rgba(239, 68, 68, 0.3);
    }
    .btn-execute.sell:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(239, 68, 68, 0.4);
    }

    .btn-execute:disabled {
        background: #374151;
        color: #6b7280;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }

    /* ========== EMPTY STATE ========== */
    .empty-trade-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        text-align: center;
        color: var(--text-muted);
    }
    .empty-trade-state i { font-size: 48px; margin-bottom: 16px; opacity: 0.3; }
    .empty-trade-state h4 { color: var(--text-primary); margin-bottom: 8px; }
    .empty-trade-state p { font-size: 13px; max-width: 280px; }

    /* ========== ALERTS ========== */
    .alert {
        padding: 14px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid var(--accent-green); color: var(--accent-green); }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid var(--accent-red); color: var(--accent-red); }

    /* ========== ADMIN BADGE ========== */
    .admin-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 16px;
    }
    .admin-badge.force_win { background: rgba(34, 197, 94, 0.15); color: var(--accent-green); }
    .admin-badge.force_loss { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }

    /* ========== MOBILE RESPONSIVE ========== */
    @media (max-width: 1024px) {
        .terminal-grid {
            grid-template-columns: 1fr;
            height: auto;
        }
        .trade-panel { max-width: 100%; }
        .chart-container { min-height: 250px; }
    }

    @media (max-width: 768px) {
        .menu-toggle { display: flex; align-items: center; justify-content: center; }
        .sidebar { transform: translateX(-100%); }
        .sidebar.open { transform: translateX(0); }
        .main-content { margin-left: 0; padding: 12px; }
        .topbar { padding: 0 12px; }
        .brand { font-size: 16px; }
        .balance-chip span { display: none; }
        .account-switcher-top button span { display: none; }
        .account-switcher-top button { padding: 6px 10px; }
        .chart-price-main { font-size: 22px; }
        .terminal-grid { gap: 12px; }
    }

    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.6);
        z-index: 998;
        backdrop-filter: blur(2px);
    }
    .sidebar-overlay.active { display: block; }

    /* Scrollbar styling */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg-card); }
    ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }
</style>

<!-- Top Bar -->
<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" onclick="toggleSidebar()" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
        <a href="/dashboard" class="brand">
            <i class="fas fa-chart-line"></i> TRUST-FX
        </a>
    </div>
    <div class="topbar-right">
        <div class="balance-chip">
            <i class="fas fa-wallet"></i>
            <span><%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %></span>
        </div>
        <form action="/trading/switch-account" method="POST" class="account-switcher-top">
            <button type="submit" name="account_type" value="real" 
                class="btn-real <%= account && account.accountType === 'real' ? 'active' : '' %>">
                <i class="fas fa-wallet"></i> <span>Real</span>
            </button>
            <button type="submit" name="account_type" value="demo" 
                class="btn-demo <%= account && account.accountType === 'demo' ? 'active' : '' %>">
                <i class="fas fa-gamepad"></i> <span>Demo</span>
            </button>
        </form>
        <div class="user-avatar" title="<%= userData && userData.username ? userData.username : 'User' %>">
            <%= userData && userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %>
        </div>
    </div>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-section">
        <div class="sidebar-title">Menu</div>
        <nav class="sidebar-nav">
            <a href="/trading" class="sidebar-link active">
                <i class="fas fa-chart-line"></i> Trading
            </a>
            <a href="/trading/positions" class="sidebar-link">
                <i class="fas fa-list"></i> Positions
            </a>
            <a href="/transactions/history" class="sidebar-link">
                <i class="fas fa-history"></i> History
            </a>
            <a href="/investments" class="sidebar-link">
                <i class="fas fa-wallet"></i> Deposit
            </a>
            <a href="/transactions/withdraw/verify" class="sidebar-link">
                <i class="fas fa-university"></i> Withdraw
            </a>
        </nav>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
        <div class="sidebar-title">Account</div>
        <nav class="sidebar-nav">
            <a href="/profile/settings" class="sidebar-link">
                <i class="fas fa-user"></i> Profile
            </a>
            <a href="/logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
</aside>

<!-- Main Content -->
<main class="main-content">
    <!-- Admin Mode Badge -->
    <% if (account && account.userRole === 'admin' && account.tradingMode !== 'normal') { %>
        <div class="admin-badge <%= account.tradingMode %>">
            <i class="fas fa-bolt"></i>
            <span>Admin Mode: <%= account.tradingMode.replace('_', ' ').toUpperCase() %></span>
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
        </div>
    <% } %>

    <!-- Currency Pairs Ticker Bar -->
    <div class="pairs-ticker" id="pairsTicker">
        <% if (pairs && pairs.length > 0) { %>
            <% pairs.forEach(pair => { %>
                <div class="ticker-item" onclick="selectPair('<%= pair.id %>', '<%= pair.symbol %>', '<%= pair.name %>', <%= pair.bid %>, <%= pair.ask %>, <%= pair.change_24h || 0 %>)">
                    <div class="ticker-symbol"><%= pair.symbol %></div>
                    <div class="ticker-price <%= (pair.change_24h || 0) >= 0 ? 'up' : 'down' %>" id="price-<%= pair.symbol %>">
                        <%= pair.bid.toFixed(5) %>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div style="color: var(--text-muted); font-size: 13px; padding: 8px;">No pairs available</div>
        <% } %>
    </div>

    <!-- Trading Terminal -->
    <div class="terminal-grid">
        <!-- Left: Chart -->
        <div class="chart-section">
            <div class="chart-header-card">
                <div class="chart-info">
                    <h2 id="chartPairName">Select a Pair</h2>
                    <p id="chartPairSymbol">Click a pair above to start trading</p>
                </div>
                <div class="chart-price-display">
                    <div class="chart-price-main" id="chartPrice">--</div>
                    <div class="chart-price-change" id="chartChange">--</div>
                </div>
            </div>
            <div class="chart-container" id="tradingview_chart">
                <div class="empty-trade-state">
                    <i class="fas fa-chart-area"></i>
                    <h4>Ready to Trade</h4>
                    <p>Select a currency pair from the ticker bar above to view the live chart and start trading.</p>
                </div>
            </div>
        </div>

        <!-- Right: Trade Panel -->
        <div class="trade-panel">
            <div class="trade-panel-header">
                <h3><i class="fas fa-handshake" style="color: var(--accent-purple);"></i> New Order</h3>
            </div>

            <% if (!pairs || pairs.length === 0) { %>
                <div class="empty-trade-state">
                    <i class="fas fa-coins"></i>
                    <h4>No Trading Pairs</h4>
                    <p>Currency pairs are currently unavailable. Please check back later.</p>
                </div>
            <% } else { %>
                <div class="selected-pair-display">
                    <div class="label">Selected Pair</div>
                    <div class="value" id="selectedPairSymbol">--</div>
                    <div class="sub" id="selectedPairName">Select a pair to trade</div>
                </div>

                <form action="/trading/open-position" method="POST" id="tradeForm">
                    <input type="hidden" name="pair_id" id="formPairId">
                    <input type="hidden" name="direction" id="directionInput" value="buy">

                    <!-- Direction Buttons -->
                    <div class="direction-buttons">
                        <button type="button" class="direction-btn buy active" onclick="setDirection('buy')">
                            <i class="fas fa-arrow-up"></i>
                            <span>Buy</span>
                        </button>
                        <button type="button" class="direction-btn sell" onclick="setDirection('sell')">
                            <i class="fas fa-arrow-down"></i>
                            <span>Sell</span>
                        </button>
                    </div>

                    <!-- Trade Amount -->
                    <div class="form-group">
                        <label style="display: block; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">
                            <i class="fas fa-dollar-sign"></i> Trade Amount
                        </label>
                        <div class="amount-input-group">
                            <span class="currency-label">$</span>
                            <input type="number" name="trade_amount" class="amount-input" id="tradeAmount" 
                                placeholder="Enter amount" step="0.01" min="0.01" oninput="calculateTrade()" required>
                        </div>
                        <div class="amount-presets" style="margin-top: 8px;">
                            <button type="button" class="preset-btn" onclick="setAmount(10)">$10</button>
                            <button type="button" class="preset-btn" onclick="setAmount(50)">$50</button>
                            <button type="button" class="preset-btn" onclick="setAmount(100)">$100</button>
                            <button type="button" class="preset-btn" onclick="setAmount(500)">$500</button>
                            <button type="button" class="preset-btn" onclick="setAmount(1000)">$1K</button>
                        </div>
                    </div>

                    <!-- Leverage -->
                    <div class="form-group">
                        <label style="display: block; font-size: 10px; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; font-weight: 600;">
                            <i class="fas fa-layer-group"></i> Leverage
                        </label>
                        <select name="leverage" class="leverage-select" id="leverage" onchange="calculateTrade()">
                            <option value="1">1:1 (No Leverage)</option>
                            <option value="10">1:10</option>
                            <option value="50">1:50</option>
                            <option value="100" selected>1:100</option>
                            <option value="200">1:200</option>
                            <option value="500">1:500</option>
                        </select>
                    </div>

                    <!-- Calculations -->
                    <div class="calc-box">
                        <div class="calc-row">
                            <span class="calc-label">Position Size:</span>
                            <span class="calc-value" id="positionSize">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Margin Required:</span>
                            <span class="calc-value" id="marginRequired">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Pip Value:</span>
                            <span class="calc-value" id="pipValue">--</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Available Balance:</span>
                            <span class="calc-value highlight" id="availableBalance">
                                <%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %>
                            </span>
                        </div>
                    </div>

                    <!-- Execute Button -->
                    <button type="submit" class="btn-execute buy" id="submitBtn" disabled>
                        <i class="fas fa-lock"></i> Select a Pair First
                    </button>
                </form>
            <% } %>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    let selectedPair = null;
    let currentDirection = 'buy';
    let tvWidget = null;
    const userBalance = <%= account && account.balance ? account.balance : 0 %>;

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('active');
    }

    function initChart(symbol) {
        const container = document.getElementById('tradingview_chart');
        container.innerHTML = ''; // Clear empty state

        if (tvWidget) {
            tvWidget.remove();
        }

        tvWidget = new TradingView.widget({
            "width": "100%",
            "height": "100%",
            "symbol": "FX:" + (symbol || "EURUSD"),
            "interval": "15",
            "timezone": "Etc/UTC",
            "theme": "dark",
            "style": "1",
            "locale": "en",
            "toolbar_bg": "#f1f3f6",
            "enable_publishing": false,
            "hide_top_toolbar": true,
            "hide_legend": true,
            "save_image": false,
            "container_id": "tradingview_chart"
        });
    }

    function selectPair(id, symbol, name, bid, ask, change24h) {
        selectedPair = { id, symbol, name, bid, ask };

        // Update form
        document.getElementById('formPairId').value = id;
        document.getElementById('selectedPairSymbol').textContent = symbol;
        document.getElementById('selectedPairName').textContent = name;

        // Update chart header
        document.getElementById('chartPairName').textContent = name;
        document.getElementById('chartPairSymbol').textContent = symbol;
        document.getElementById('chartPrice').textContent = bid.toFixed(5);

        const changeEl = document.getElementById('chartChange');
        if (change24h >= 0) {
            changeEl.innerHTML = '<i class="fas fa-arrow-up"></i> +' + change24h.toFixed(2) + '%';
            changeEl.className = 'chart-price-change up';
        } else {
            changeEl.innerHTML = '<i class="fas fa-arrow-down"></i> ' + change24h.toFixed(2) + '%';
            changeEl.className = 'chart-price-change down';
        }

        // Enable submit button
        const btn = document.getElementById('submitBtn');
        btn.disabled = false;
        updateSubmitButton();

        // Highlight active ticker
        document.querySelectorAll('.ticker-item').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');

        // Init chart
        initChart(symbol);
        calculateTrade();
    }

    function setDirection(dir) {
        currentDirection = dir;
        document.getElementById('directionInput').value = dir;

        document.querySelectorAll('.direction-btn').forEach(t => t.classList.remove('active'));
        document.querySelector('.direction-btn.' + dir).classList.add('active');

        updateSubmitButton();
    }

    function setAmount(amount) {
        document.getElementById('tradeAmount').value = amount;
        calculateTrade();
    }

    function calculateTrade() {
        if (!selectedPair) return;

        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;
        const leverage = parseInt(document.getElementById('leverage').value) || 1;

        // Calculate position size based on amount and leverage
        // Amount = margin, Position Size = Amount * Leverage
        const positionSize = amount * leverage;
        const marginRequired = amount; // The amount entered is the margin
        const pipValue = (positionSize / 100000) * 10; // Approximate pip value

        document.getElementById('positionSize').textContent = '$' + positionSize.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('marginRequired').textContent = '$' + marginRequired.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        document.getElementById('pipValue').textContent = '$' + pipValue.toFixed(2);

        // Check if user has enough balance
        const marginEl = document.getElementById('marginRequired');
        if (amount > userBalance) {
            marginEl.style.color = 'var(--accent-red)';
        } else {
            marginEl.style.color = '#fff';
        }

        updateSubmitButton();
    }

    function updateSubmitButton() {
        const btn = document.getElementById('submitBtn');
        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;

        if (!selectedPair) {
            btn.className = 'btn-execute buy';
            btn.innerHTML = '<i class="fas fa-lock"></i> Select a Pair First';
            btn.disabled = true;
            return;
        }

        if (amount <= 0) {
            btn.className = 'btn-execute ' + currentDirection;
            btn.innerHTML = '<i class="fas fa-lock"></i> Enter Amount';
            btn.disabled = true;
            return;
        }

        if (amount > userBalance) {
            btn.className = 'btn-execute ' + currentDirection;
            btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Insufficient Balance';
            btn.disabled = true;
            return;
        }

        btn.className = 'btn-execute ' + currentDirection;
        btn.innerHTML = currentDirection === 'buy'
            ? '<i class="fas fa-arrow-up"></i> Buy ' + selectedPair.symbol
            : '<i class="fas fa-arrow-down"></i> Sell ' + selectedPair.symbol;
        btn.disabled = false;
    }

    // Socket.io for live price updates
    if (typeof io !== 'undefined') {
        const socket = io();

        socket.on('forex_price', (data) => {
            const priceEl = document.getElementById('price-' + data.symbol);
            if (priceEl) {
                priceEl.textContent = data.bid.toFixed(5);
                // Flash effect
                priceEl.style.transition = 'none';
                priceEl.style.color = data.bid > parseFloat(priceEl.dataset.lastPrice || 0) ? 'var(--accent-green)' : 'var(--accent-red)';
                priceEl.dataset.lastPrice = data.bid;
                setTimeout(() => {
                    priceEl.style.transition = 'color 0.5s';
                    priceEl.style.color = '';
                }, 300);
            }

            if (selectedPair && selectedPair.symbol === data.symbol) {
                document.getElementById('chartPrice').textContent = data.bid.toFixed(5);
            }
        });

        socket.on('position_update', (data) => {
            location.reload();
        });
    }

    // Form validation before submit
    document.getElementById('tradeForm').addEventListener('submit', function(e) {
        const amount = parseFloat(document.getElementById('tradeAmount').value) || 0;
        if (amount <= 0) {
            e.preventDefault();
            alert('Please enter a valid trade amount.');
            return;
        }
        if (amount > userBalance) {
            e.preventDefault();
            alert('Insufficient balance for this trade.');
            return;
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
        // No auto-init chart - wait for user to select a pair
    });
</script>