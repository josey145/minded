<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
        --bg-primary: #0a0e1a;
        --bg-secondary: #111827;
        --bg-card: #0f172a;
        --bg-hover: #1e293b;
        --border-color: #1e293b;
        --text-primary: #f1f5f9;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --accent-green: #22c55e;
        --accent-red: #ef4444;
        --accent-blue: #3b82f6;
        --accent-purple: #a78bfa;
        --accent-orange: #f59e0b;
        --sidebar-width: 240px;
        --topbar-height: 56px;
    }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: var(--bg-primary);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    /* ========== TOP BAR ========== */
    .topbar {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: var(--topbar-height);
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 16px;
        z-index: 1000;
    }

    .topbar-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: var(--text-secondary);
        font-size: 20px;
        cursor: pointer;
        padding: 8px;
        width: 40px; height: 40px;
        border-radius: 8px;
        transition: background 0.2s;
    }
    .menu-toggle:hover { background: var(--bg-hover); }

    .brand {
        font-size: 18px;
        font-weight: 800;
        color: var(--accent-green);
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .balance-chip {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--bg-card);
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
    }
    .balance-chip i { color: var(--accent-green); font-size: 14px; }
    .balance-chip span {
        font-weight: 700;
        color: var(--accent-green);
        font-family: 'Courier New', monospace;
        font-size: 14px;
    }

    .account-switcher-top {
        display: flex;
        gap: 6px;
    }

    .account-switcher-top button {
        padding: 6px 14px;
        border-radius: 8px;
        border: none;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .btn-real {
        background: rgba(34, 197, 94, 0.15);
        color: var(--accent-green);
        border: 1px solid rgba(34, 197, 94, 0.3) !important;
    }
    .btn-real:hover { background: rgba(34, 197, 94, 0.25); }

    .btn-demo {
        background: transparent;
        color: var(--text-muted);
        border: 1px solid var(--border-color) !important;
    }
    .btn-demo:hover {
        background: rgba(139, 92, 246, 0.1);
        color: var(--accent-purple);
        border-color: rgba(139, 92, 246, 0.3) !important;
    }
    .btn-demo.active {
        background: rgba(139, 92, 246, 0.15);
        color: var(--accent-purple);
        border-color: rgba(139, 92, 246, 0.3) !important;
    }

    .user-avatar {
        width: 32px; height: 32px;
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: white;
        font-size: 13px;
        cursor: pointer;
        flex-shrink: 0;
    }

    /* ========== SIDEBAR ========== */
    .sidebar {
        position: fixed;
        top: var(--topbar-height); left: 0;
        width: var(--sidebar-width);
        height: calc(100vh - var(--topbar-height));
        background: var(--bg-card);
        border-right: 1px solid var(--border-color);
        padding: 16px 0;
        overflow-y: auto;
        z-index: 999;
        transition: transform 0.3s ease;
    }

    .sidebar-section { padding: 0 12px 16px; }
    .sidebar-title {
        font-size: 10px;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 1px;
        margin-bottom: 10px;
        font-weight: 600;
    }
    .sidebar-nav { display: flex; flex-direction: column; gap: 3px; }
    .sidebar-link {
        padding: 10px 14px;
        border-radius: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
        background: none;
        width: 100%;
        font-size: 14px;
        text-align: left;
    }
    .sidebar-link:hover { background: var(--bg-hover); color: var(--text-primary); }
    .sidebar-link.active { background: rgba(34, 197, 94, 0.1); color: var(--accent-green); font-weight: 600; }
    .sidebar-link i { width: 20px; text-align: center; font-size: 15px; }
    .sidebar-divider { height: 1px; background: var(--border-color); margin: 10px 12px; }

    /* ========== MAIN CONTENT ========== */
    .main-content {
        margin-left: var(--sidebar-width);
        margin-top: var(--topbar-height);
        padding: 20px;
        min-height: calc(100vh - var(--topbar-height));
    }

    /* ========== STATS CARDS ========== */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: linear-gradient(135deg, var(--bg-secondary), var(--bg-card));
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }

    .stat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
    }
    .stat-label { color: var(--text-secondary); font-size: 12px; font-weight: 500; }
    .stat-icon { font-size: 16px; }
    .stat-value { font-size: 22px; font-weight: 800; font-family: 'Courier New', monospace; }
    .stat-sub { font-size: 11px; color: var(--text-muted); margin-top: 4px; display: flex; align-items: center; gap: 4px; }
    .stat-sub.positive { color: var(--accent-green); }
    .stat-sub.negative { color: var(--accent-red); }

    /* ========== TRADING GRID ========== */
    .trading-grid {
        display: grid;
        grid-template-columns: 1fr 340px;
        gap: 20px;
    }

    /* ========== CHART CARD ========== */
    .chart-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 16px;
    }
    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        flex-wrap: wrap;
        gap: 10px;
    }
    .chart-header h3 { margin: 0; font-size: 18px; color: var(--text-primary); }
    .chart-header p { margin: 3px 0 0; color: var(--text-muted); font-size: 12px; }
    .chart-price { text-align: right; }
    .chart-price-main { font-size: 24px; font-weight: 800; color: var(--text-primary); font-family: 'Courier New', monospace; }
    .chart-price-change { color: var(--accent-green); font-size: 12px; font-weight: 600; }
    .chart-area { height: 300px; background: var(--bg-card); border-radius: 10px; }

    /* ========== PAIRS SECTION ========== */
    .pairs-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
    }
    .pairs-card h3 {
        margin: 0 0 14px;
        font-size: 15px;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pairs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
    }
    .pair-card {
        background: var(--bg-card);
        border: 2px solid transparent;
        border-radius: 10px;
        padding: 14px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .pair-card:hover { border-color: var(--accent-purple); background: var(--bg-hover); transform: translateY(-2px); }
    .pair-card.active { border-color: var(--accent-green); background: rgba(34, 197, 94, 0.08); }
    .pair-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .pair-symbol { font-weight: 700; color: #fff; font-size: 13px; }
    .pair-status { width: 7px; height: 7px; background: var(--accent-green); border-radius: 50%; animation: pulse 2s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    .pair-prices { display: flex; justify-content: space-between; margin-bottom: 5px; }
    .price-box { text-align: center; }
    .price-label-small { font-size: 9px; color: var(--text-muted); text-transform: uppercase; }
    .price-value-small { font-size: 14px; font-weight: 700; font-family: 'Courier New', monospace; }
    .price-value-small.bid { color: var(--accent-red); }
    .price-value-small.ask { color: var(--accent-green); }
    .pair-spread { font-size: 10px; color: var(--text-muted); text-align: center; padding-top: 5px; border-top: 1px solid var(--border-color); }

    /* ========== TRADE PANEL ========== */
    .trade-panel {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
        height: fit-content;
    }
    .trade-panel h3 { margin: 0 0 14px; font-size: 15px; color: var(--text-primary); display: flex; align-items: center; gap: 8px; }
    .selected-pair-box { background: var(--bg-card); border-radius: 10px; padding: 14px; margin-bottom: 14px; text-align: center; }
    .selected-pair-label { font-size: 11px; color: var(--text-muted); margin-bottom: 3px; }
    .selected-pair-value { font-size: 18px; font-weight: 700; color: #fff; }

    .direction-tabs { display: flex; gap: 8px; margin-bottom: 14px; }
    .direction-tab {
        flex: 1;
        padding: 12px;
        border-radius: 8px;
        border: none;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }
    .direction-tab.buy { background: rgba(34,197,94,0.1); color: var(--accent-green); }
    .direction-tab.buy.active { background: var(--accent-green); color: white; }
    .direction-tab.sell { background: rgba(239,68,68,0.1); color: var(--accent-red); }
    .direction-tab.sell.active { background: var(--accent-red); color: white; }

    .form-group { margin-bottom: 12px; }
    .form-label {
        display: block;
        font-size: 10px;
        color: var(--text-muted);
        margin-bottom: 5px;
        text-transform: uppercase;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .form-input, .form-select {
        width: 100%;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px 12px;
        color: var(--text-primary);
        font-size: 14px;
        font-family: 'Courier New', monospace;
    }
    .form-input:focus, .form-select:focus { outline: none; border-color: var(--accent-purple); }

    .calculation-box { background: var(--bg-card); border-radius: 10px; padding: 14px; margin-bottom: 14px; }
    .calc-row { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 12px; }
    .calc-row:last-child { margin-bottom: 0; padding-top: 6px; border-top: 1px solid var(--border-color); font-weight: 600; }
    .calc-label { color: var(--text-muted); }
    .calc-value { color: #fff; font-family: 'Courier New', monospace; }
    .calc-value.success { color: var(--accent-green); }
    .calc-value.warning { color: var(--accent-orange); }

    .btn-submit {
        width: 100%;
        padding: 14px;
        border-radius: 10px;
        border: none;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-submit.buy { background: var(--accent-green); color: white; }
    .btn-submit.buy:hover { background: #16a34a; }
    .btn-submit.sell { background: var(--accent-red); color: white; }
    .btn-submit.sell:hover { background: #dc2626; }
    .btn-submit:disabled { background: #374151; color: #6b7280; cursor: not-allowed; }

    /* ========== POSITIONS TABLE ========== */
    .positions-card {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
        margin-top: 16px;
    }
    .positions-card h3 { margin: 0 0 14px; font-size: 15px; color: var(--text-primary); }
    .positions-table { width: 100%; border-collapse: collapse; }
    .positions-table th {
        color: var(--text-muted);
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
        padding: 10px;
        border-bottom: 1px solid var(--border-color);
        white-space: nowrap;
    }
    .positions-table td {
        padding: 12px 10px;
        border-bottom: 1px solid var(--border-color);
        font-size: 13px;
        white-space: nowrap;
    }
    .positions-table tr:hover { background: rgba(255,255,255,0.02); }
    .position-type {
        text-transform: uppercase;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 4px;
        display: inline-block;
    }
    .position-type.buy { background: rgba(34,197,94,0.15); color: var(--accent-green); }
    .position-type.sell { background: rgba(239,68,68,0.15); color: var(--accent-red); }
    .position-pnl { font-family: 'Courier New', monospace; font-weight: 700; }
    .position-pnl.positive { color: var(--accent-green); }
    .position-pnl.negative { color: var(--accent-red); }
    .btn-close {
        background: var(--accent-red);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-close:hover { background: #dc2626; }

    .empty-state { text-align: center; padding: 32px; color: var(--text-muted); }
    .empty-state i { font-size: 28px; margin-bottom: 10px; opacity: 0.3; }

    /* ========== ALERTS ========== */
    .alert {
        padding: 14px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .alert-success { background: rgba(34,197,94,0.1); border: 1px solid var(--accent-green); color: var(--accent-green); }
    .alert-error { background: rgba(239,68,68,0.1); border: 1px solid var(--accent-red); color: var(--accent-red); }

    /* ========== ADMIN MODE BADGE ========== */
    .admin-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 16px;
    }
    .admin-badge.force_win { background: rgba(34, 197, 94, 0.15); color: var(--accent-green); }
    .admin-badge.force_loss { background: rgba(239, 68, 68, 0.15); color: var(--accent-red); }

    /* ========== TABLE SCROLL ========== */
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .table-scroll::-webkit-scrollbar { height: 6px; }
    .table-scroll::-webkit-scrollbar-track { background: var(--bg-card); border-radius: 3px; }
    .table-scroll::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 3px; }

    /* ========== MOBILE RESPONSIVE ========== */
    @media (max-width: 1024px) {
        .trading-grid { grid-template-columns: 1fr; }
        .trade-panel { max-width: 100%; }
    }

    @media (max-width: 768px) {
        .menu-toggle { display: flex; align-items: center; justify-content: center; }
        .sidebar { transform: translateX(-100%); }
        .sidebar.open { transform: translateX(0); }
        .main-content { margin-left: 0; padding: 16px; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .stat-card { padding: 14px; }
        .stat-value { font-size: 18px; }
        .balance-chip span { display: none; }
        .account-switcher-top button span { display: none; }
        .account-switcher-top button { padding: 6px 10px; }
        .pairs-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .pair-card { padding: 12px; }
        .chart-area { height: 240px; }
        .topbar { padding: 0 12px; }
        .brand { font-size: 16px; }
    }

    @media (max-width: 768px) {
  html { font-size: 15px; }
  
  .sidebar { 
    padding-top: env(safe-area-inset-top);
  }
  
  .stats-grid { 
    grid-template-columns: 1fr; /* stack vertically */
  }
  
  .chart-area { 
    height: 200px; /* not 240px */
  }
  
  .direction-tabs { 
    flex-direction: column; 
    gap: 8px; 
  }
  
  input, select, button { 
    min-height: 44px; 
    min-width: 44px; 
  }
  
  input { 
    font-size: 16px; /* prevents iOS zoom on focus */
    padding: 14px 16px; 
  }
}

* { 
  -webkit-tap-highlight-color: transparent; 
  touch-action: manipulation; 
}

    @media (max-width: 480px) {
        .stats-grid { grid-template-columns: 1fr; }
        .pairs-grid { grid-template-columns: 1fr; }
        .chart-header { flex-direction: column; align-items: flex-start; }
        .chart-price { text-align: left; }
        .chart-price-main { font-size: 20px; }
        .direction-tab { font-size: 12px; padding: 10px; }
        .main-content { padding: 12px; }
        .positions-table th, .positions-table td { padding: 8px 6px; font-size: 12px; }
        .btn-close { padding: 5px 10px; font-size: 10px; }
    }

    /* Overlay for mobile sidebar */
    .sidebar-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.6);
        z-index: 998;
        backdrop-filter: blur(2px);
    }
    .sidebar-overlay.active { display: block; }
</style>

<!-- Top Bar -->
<div class="topbar">
    <div class="topbar-left">
        <button class="menu-toggle" onclick="toggleSidebar()" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
        <a href="/dashboard" class="brand">
            <i class="fas fa-chart-line"></i> TRUST-FX
        </a>
    </div>
    <div class="topbar-right">
        <div class="balance-chip">
            <i class="fas fa-wallet"></i>
            <span><%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %></span>
        </div>
        <form action="/trading/switch-account" method="POST" class="account-switcher-top">
            <button type="submit" name="account_type" value="real" 
                class="btn-real <%= account && account.accountType === 'real' ? 'active' : '' %>">
                <i class="fas fa-wallet"></i> <span>Real</span>
            </button>
            <button type="submit" name="account_type" value="demo" 
                class="btn-demo <%= account && account.accountType === 'demo' ? 'active' : '' %>">
                <i class="fas fa-gamepad"></i> <span>Demo</span>
            </button>
        </form>
        <div class="user-avatar" title="<%= userData && userData.username ? userData.username : 'User' %>">
            <%= userData && userData.username ? userData.username.charAt(0).toUpperCase() : 'U' %>
        </div>
    </div>
</div>

<!-- Sidebar Overlay -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
    <div class="sidebar-section">
        <div class="sidebar-title">Menu</div>
        <nav class="sidebar-nav">
            <a href="/trading" class="sidebar-link active">
                <i class="fas fa-chart-line"></i> Trading
            </a>
            <a href="/trading/positions" class="sidebar-link">
                <i class="fas fa-list"></i> Positions
            </a>
            <a href="/transactions/history" class="sidebar-link">
                <i class="fas fa-history"></i> History
            </a>
            <a href="/investments" class="sidebar-link">
                <i class="fas fa-wallet"></i> Deposit
            </a>
            <a href="/transactions/withdraw/verify" class="sidebar-link">
                <i class="fas fa-university"></i> Withdraw
            </a>
        </nav>
    </div>
    <div class="sidebar-divider"></div>
    <div class="sidebar-section">
        <div class="sidebar-title">Account</div>
        <nav class="sidebar-nav">
            <a href="/profile/settings" class="sidebar-link">
                <i class="fas fa-user"></i> Profile
            </a>
            
            <a href="/logout" class="sidebar-link">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </nav>
    </div>
</aside>

<!-- Main Content -->
<main class="main-content">
    <!-- Admin Mode Badge (only for admin) -->
    <% if (account && account.userRole === 'admin' && account.tradingMode !== 'normal') { %>
        <div class="admin-badge <%= account.tradingMode %>">
            <i class="fas fa-bolt"></i>
            <span>Admin Mode: <%= account.tradingMode.replace('_', ' ').toUpperCase() %></span>
        </div>
    <% } %>

    <!-- Flash Messages -->
    <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> <%= success_msg %>
        </div>
    <% } %>
    <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> <%= error_msg %>
        </div>
    <% } %>

    <!-- Stats Cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-label"><%= account && account.accountType === 'demo' ? 'Demo Balance' : 'Balance' %></span>
                <i class="fas fa-wallet stat-icon" style="color: var(--accent-green);"></i>
            </div>
            <div class="stat-value" style="color: var(--accent-green);">
                <%= formatCurrency(account && account.balance ? account.balance : 0, account && account.currency ? account.currency : 'USD') %>
            </div>
            <div class="stat-sub"><%= account && account.accountType === 'demo' ? 'Virtual Funds' : 'Real Funds' %></div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-label">Equity</span>
                <i class="fas fa-chart-pie stat-icon" style="color: var(--accent-blue);"></i>
            </div>
            <div class="stat-value" style="color: var(--accent-blue);">
                <%= formatCurrency(account && account.equity ? account.equity : 0, account && account.currency ? account.currency : 'USD') %>
            </div>
            <div class="stat-sub <%= account && account.totalOpenPnL >= 0 ? 'positive' : 'negative' %>">
                <i class="fas fa-<%= account && account.totalOpenPnL >= 0 ? 'arrow-up' : 'arrow-down' %>"></i>
                <%= account && account.totalOpenPnL >= 0 ? '+' : '' %><%= formatCurrency(account && account.totalOpenPnL ? account.totalOpenPnL : 0, account && account.currency ? account.currency : 'USD') %>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-label">Free Margin</span>
                <i class="fas fa-unlock stat-icon" style="color: var(--accent-purple);"></i>
            </div>
            <div class="stat-value" style="color: var(--accent-purple);">
                <%= formatCurrency(account && account.freeMargin ? account.freeMargin : 0, account && account.currency ? account.currency : 'USD') %>
            </div>
            <div class="stat-sub">Available to trade</div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <span class="stat-label">Margin Level</span>
                <i class="fas fa-shield-alt stat-icon" style="color: var(--accent-orange);"></i>
            </div>
            <div class="stat-value" style="color: var(--accent-orange);">
                <%= account && account.marginLevel ? account.marginLevel.toFixed(1) : '0.0' %>
            </div>
            <div class="stat-sub <%= account && account.marginLevel > 100 ? 'positive' : 'negative' %>">
                <i class="fas fa-<%= account && account.marginLevel > 100 ? 'check-circle' : 'exclamation-triangle' %>"></i>
                <%= account && account.marginLevel > 100 ? 'Safe' : 'Warning' %>
            </div>
        </div>
    </div>

    <div class="trading-grid">
        <!-- Left Column -->
        <div>
            <!-- Chart -->
            <div class="chart-card">
                <div class="chart-header">
                    <div>
                        <h3 id="chartPairName">Select a Pair</h3>
                        <p id="chartPairSymbol">Click a pair below to start trading</p>
                    </div>
                    <div class="chart-price">
                        <div class="chart-price-main" id="chartPrice">0.00000</div>
                        <div class="chart-price-change" id="chartChange">+0.00%</div>
                    </div>
                </div>
                <div class="chart-area" id="tradingview_chart"></div>
            </div>

            <!-- Currency Pairs -->
            <div class="pairs-card">
                <h3><i class="fas fa-coins" style="color: var(--accent-purple);"></i> Currency Pairs</h3>
                <div class="pairs-grid">
                    <% if (pairs && pairs.length > 0) { %>
                        <% pairs.forEach(pair => { %>
                            <div class="pair-card" onclick="selectPair('<%= pair.id %>', '<%= pair.symbol %>', '<%= pair.name %>', <%= pair.bid %>, <%= pair.ask %>, <%= pair.change_24h || 0 %>)">
                                <div class="pair-header">
                                    <span class="pair-symbol"><%= pair.symbol %></span>
                                    <span class="pair-status"></span>
                                </div>
                                <div class="pair-prices">
                                    <div class="price-box">
                                        <div class="price-label-small">Bid</div>
                                        <div class="price-value-small bid" id="bid-<%= pair.symbol %>"><%= pair.bid.toFixed(5) %></div>
                                    </div>
                                    <div class="price-box">
                                        <div class="price-label-small">Ask</div>
                                        <div class="price-value-small ask" id="ask-<%= pair.symbol %>"><%= pair.ask.toFixed(5) %></div>
                                    </div>
                                </div>
                                <div class="pair-spread">Spread: <%= (pair.spread * 10000).toFixed(1) %> pips</div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state" style="grid-column: 1 / -1;">
                            <i class="fas fa-chart-line"></i>
                            <p>No currency pairs available</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Open Positions -->
            <% if (openPositions && openPositions.length > 0) { %>
            <div class="positions-card">
                <h3><i class="fas fa-list" style="color: var(--accent-blue);"></i> Open Positions (<%= openPositions.length %>)</h3>
                <div class="table-scroll">
                    <table class="positions-table">
                        <thead>
                            <tr>
                                <th>Pair</th>
                                <th>Type</th>
                                <th>Size</th>
                                <th>Entry</th>
                                <th>Current</th>
                                <th>P&L ($)</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% openPositions.forEach(pos => { %>
                                <tr>
                                    <td>
                                        <div style="font-weight: 700; color: #fff;"><%= pos.pair_symbol %></div>
                                        <div style="color: var(--text-muted); font-size: 10px;"><%= pos.pair_name %></div>
                                    </td>
                                    <td>
                                        <span class="position-type <%= pos.direction %>"><%= pos.direction %></span>
                                    </td>
                                    <td style="font-family: monospace; color: #fff;"><%= pos.lot_size %> lots</td>
                                    <td style="font-family: monospace; color: #fff;"><%= pos.entry_price.toFixed(5) %></td>
                                    <td style="font-family: monospace; color: #fff;"><%= pos.current_price ? pos.current_price.toFixed(5) : '-' %></td>
                                    <td class="position-pnl <%= pos.profit_loss >= 0 ? 'positive' : 'negative' %>">
                                        <%= pos.profit_loss >= 0 ? '+' : '' %><%= formatCurrency(pos.profit_loss || 0, account && account.currency ? account.currency : 'USD') %>
                                    </td>
                                    <td>
                                        <form action="/trading/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                            <button type="submit" class="btn-close"><i class="fas fa-times"></i> Close</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Right Column: Trade Panel -->
        <div class="trade-panel">
            <h3><i class="fas fa-handshake" style="color: var(--accent-purple);"></i> New Order</h3>

            <div class="selected-pair-box">
                <div class="selected-pair-label">Selected Pair</div>
                <div class="selected-pair-value" id="selectedPairDisplay">--</div>
            </div>

            <form action="/trading/open-position" method="POST" id="tradeForm">
                <input type="hidden" name="pair_id" id="formPairId">

                <!-- Direction -->
                <div class="direction-tabs">
                    <button type="button" class="direction-tab buy active" onclick="setDirection('buy')">
                        <i class="fas fa-arrow-up"></i> Buy
                    </button>
                    <button type="button" class="direction-tab sell" onclick="setDirection('sell')">
                        <i class="fas fa-arrow-down"></i> Sell
                    </button>
                </div>
                <input type="hidden" name="direction" id="directionInput" value="buy">

                <!-- Lot Size -->
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-coins"></i> Lot Size</label>
                    <select name="lot_size" class="form-select" id="lotSize" onchange="calculateMargin()">
                        <option value="0.01">0.01 Micro (1,000 units)</option>
                        <option value="0.1">0.1 Mini (10,000 units)</option>
                        <option value="1" selected>1.0 Standard (100,000 units)</option>
                        <option value="2">2.0 (200,000 units)</option>
                        <option value="5">5.0 (500,000 units)</option>
                        <option value="10">10.0 (1,000,000 units)</option>
                    </select>
                </div>

                <!-- Leverage -->
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-layer-group"></i> Leverage</label>
                    <select name="leverage" class="form-select" id="leverage" onchange="calculateMargin()">
                        <option value="50">1:50</option>
                        <option value="100" selected>1:100</option>
                        <option value="200">1:200</option>
                        <option value="500">1:500</option>
                    </select>
                </div>

                <!-- Stop Loss -->
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-shield-halved"></i> Stop Loss (optional)</label>
                    <input type="number" name="stop_loss" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Take Profit -->
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-bullseye"></i> Take Profit (optional)</label>
                    <input type="number" name="take_profit" class="form-input" step="0.00001" placeholder="0.00000">
                </div>

                <!-- Calculations -->
                <div class="calculation-box">
                    <div class="calc-row">
                        <span class="calc-label">Contract Size:</span>
                        <span class="calc-value" id="contractSize">100,000</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Pip Value:</span>
                        <span class="calc-value" id="pipValue">$10.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Margin Required:</span>
                        <span class="calc-value" id="marginRequired">$1,000.00</span>
                    </div>
                    <div class="calc-row">
                        <span class="calc-label">Min Trade:</span>
                        <span class="calc-value" id="minTrade">$10.00</span>
                    </div>
                </div>

                <button type="submit" class="btn-submit buy" id="submitBtn" disabled>
                    <i class="fas fa-lock-open"></i> Open Position
                </button>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>

<script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
<script src="/socket.io/socket.io.js"></script>

<script>
    let selectedPair = null;
    let currentDirection = 'buy';
    let tvWidget = null;

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('active');
    }

    function initChart(symbol) {
        if (tvWidget) {
            tvWidget.remove();
        }

        tvWidget = new TradingView.widget({
            "width": "100%",
            "height": 300,
            "symbol": "FX:" + (symbol || "EURUSD"),
            "interval": "15",
            "timezone": "Etc/UTC",
            "theme": "dark",
            "style": "1",
            "locale": "en",
            "toolbar_bg": "#f1f3f6",
            "enable_publishing": false,
            "hide_top_toolbar": true,
            "hide_legend": true,
            "save_image": false,
            "container_id": "tradingview_chart"
        });
    }

    function selectPair(id, symbol, name, bid, ask, change24h) {
        selectedPair = { id, symbol, name, bid, ask };

        document.getElementById('formPairId').value = id;
        document.getElementById('selectedPairDisplay').textContent = symbol;
        document.getElementById('chartPairName').textContent = name;
        document.getElementById('chartPairSymbol').textContent = symbol;
        document.getElementById('chartPrice').textContent = bid.toFixed(5);

        const changeEl = document.getElementById('chartChange');
        if (change24h >= 0) {
            changeEl.innerHTML = '<i class="fas fa-arrow-up"></i> +' + change24h.toFixed(2) + '%';
            changeEl.style.color = 'var(--accent-green)';
        } else {
            changeEl.innerHTML = '<i class="fas fa-arrow-down"></i> ' + change24h.toFixed(2) + '%';
            changeEl.style.color = 'var(--accent-red)';
        }

        document.getElementById('submitBtn').disabled = false;

        document.querySelectorAll('.pair-card').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');

        initChart(symbol);
        calculateMargin();
    }

    function setDirection(dir) {
        currentDirection = dir;
        document.getElementById('directionInput').value = dir;

        document.querySelectorAll('.direction-tab').forEach(t => t.classList.remove('active'));
        document.querySelector('.direction-tab.' + dir).classList.add('active');

        const btn = document.getElementById('submitBtn');
        btn.className = 'btn-submit ' + dir;
        btn.innerHTML = dir === 'buy' 
            ? '<i class="fas fa-arrow-up"></i> Open BUY Position' 
            : '<i class="fas fa-arrow-down"></i> Open SELL Position';
    }

    function calculateMargin() {
        if (!selectedPair) return;

        const lotSize = parseFloat(document.getElementById('lotSize').value);
        const leverage = parseInt(document.getElementById('leverage').value);
        const contractSize = lotSize * 100000;
        const marginRequired = contractSize / leverage;
        const pipValue = lotSize * 10;

        document.getElementById('contractSize').textContent = contractSize.toLocaleString();
        document.getElementById('pipValue').textContent = '$' + pipValue.toFixed(2);
        document.getElementById('marginRequired').textContent = '$' + marginRequired.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});

        const minEl = document.getElementById('minTrade');
        if (marginRequired < 10) {
            minEl.textContent = 'Below $10! Increase size';
            minEl.className = 'calc-value warning';
        } else {
            minEl.textContent = '$10.00 ✓';
            minEl.className = 'calc-value success';
        }
    }

    if (typeof io !== 'undefined') {
        const socket = io();

        socket.on('forex_price', (data) => {
            const bidEl = document.getElementById('bid-' + data.symbol);
            const askEl = document.getElementById('ask-' + data.symbol);

            if (bidEl) bidEl.textContent = data.bid.toFixed(5);
            if (askEl) askEl.textContent = data.ask.toFixed(5);

            if (selectedPair && selectedPair.symbol === data.symbol) {
                document.getElementById('chartPrice').textContent = data.bid.toFixed(5);
            }
        });

        socket.on('position_update', (data) => {
            location.reload();
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initChart('EURUSD');
    });
</script>