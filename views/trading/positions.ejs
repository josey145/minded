<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root {
    --void: #0a0a0f;
    --void-elevated: #111118;
    --void-card: #14141d;
    --void-hover: #1a1a26;
    --border: #1e1e2e;
    --border-light: rgba(255,255,255,0.06);

    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-muted: #52525b;

    --mint: #2dd4a7;
    --mint-glow: rgba(45, 212, 167, 0.15);
    --mint-soft: rgba(45, 212, 167, 0.1);
    --indigo: #6366f1;
    --indigo-glow: rgba(99, 102, 241, 0.15);
    --indigo-soft: rgba(99, 102, 241, 0.1);
    --alert: #ef4444;
    --alert-glow: rgba(239, 68, 68, 0.15);
    --alert-soft: rgba(239, 68, 68, 0.1);

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
}

* { box-sizing: border-box; }

.positions-container { max-width: 1200px; margin: 0 auto; padding: 100px 20px 40px; font-family: var(--font-body); }

.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; }
.page-header h2 { color: var(--text-primary); font-family: var(--font-display); font-size: 28px; font-weight: 700; margin: 0; letter-spacing: -0.3px; }

.live-indicator { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--mint); margin-top: 6px; font-weight: 500; }
.live-dot { width: 8px; height: 8px; background-color: var(--mint); border-radius: 50%; box-shadow: 0 0 8px var(--mint-glow); animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
.stat-card {
    background-color: var(--void-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
}
.stat-card:hover { border-color: var(--border-light); transform: translateY(-2px); }
.stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--mint), transparent);
}
.stat-card .label { font-size: 11px; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.8px; font-weight: 600; margin-bottom: 10px; }
.stat-card .value { font-family: var(--font-mono); font-size: 22px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.3px; }
.stat-card .value.positive { color: var(--mint); }
.stat-card .value.negative { color: var(--alert); }

.positions-card { background-color: var(--void-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow-x: auto; }
.positions-table { width: 100%; border-collapse: collapse; color: var(--text-primary); min-width: 900px; }
.positions-table th {
    background-color: var(--indigo-soft);
    padding: 16px;
    text-align: left;
    font-size: 11px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    border-bottom: 1px solid var(--border);
}
.positions-table td { padding: 16px; border-bottom: 1px solid var(--border); font-size: 14px; font-family: var(--font-mono); }
.positions-table tr:hover { background-color: var(--void-hover); }
.positions-table tr:last-child td { border-bottom: none; }
.positions-table td.positive { color: var(--mint); }
.positions-table td.negative { color: var(--alert); }

.asset-cell { display: flex; align-items: center; gap: 12px; font-family: var(--font-body); }
.asset-icon {
    width: 40px; height: 40px;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--indigo), #4f46e5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 12px;
    color: #ffffff;
    font-family: var(--font-display);
    box-shadow: 0 4px 14px var(--indigo-glow);
    flex-shrink: 0;
}

.side-badge { padding: 4px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; font-family: var(--font-body); }
.side-buy { background-color: var(--mint-soft); color: var(--mint); }
.side-sell { background-color: var(--alert-soft); color: var(--alert); }

.pnl-badge { padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 700; }
.pnl-positive { background-color: var(--mint-soft); color: var(--mint); }
.pnl-negative { background-color: var(--alert-soft); color: var(--alert); }

.close-btn {
    background-color: var(--alert);
    color: #ffffff;
    border: none;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
}
.close-btn:hover { background-color: #dc2626; transform: translateY(-1px); box-shadow: 0 4px 14px var(--alert-glow); }

.empty-state { text-align: center; padding: 64px 20px; color: var(--text-secondary); font-family: var(--font-body); }
.empty-state svg { width: 64px; height: 64px; margin-bottom: 16px; opacity: 0.3; stroke: var(--mint); }
.empty-state h3 { color: var(--text-primary); font-family: var(--font-display); margin-bottom: 8px; font-size: 18px; font-weight: 600; }

.nav-btn {
    background-color: var(--void-card);
    color: var(--text-secondary);
    text-decoration: none;
    padding: 10px 20px;
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-body);
    transition: all 0.2s ease;
    border: 1px solid var(--border);
}
.nav-btn:hover { background-color: var(--void-hover); color: var(--text-primary); border-color: var(--border-light); }
.nav-btn.primary { background-color: var(--mint); color: #06251c; border-color: var(--mint); font-weight: 700; }
.nav-btn.primary:hover { background-color: #26bb92; box-shadow: 0 4px 14px var(--mint-glow); }

.sl-tp { font-size: 11px; color: var(--text-muted); margin-top: 4px; font-family: var(--font-body); }
.sl-tp span { color: var(--text-secondary); font-family: var(--font-mono); }

.price-change { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-family: var(--font-mono); margin-top: 2px; }
.price-change.up { color: var(--mint); }
.price-change.down { color: var(--alert); }

.stale-banner {
    display: none;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(245,158,11,0.02));
    border: 1px solid rgba(245,158,11,0.2);
    color: #f59e0b;
    padding: 12px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    font-family: var(--font-body);
    margin-bottom: 20px;
}
.stale-banner.visible { display: flex; }

@media (max-width: 768px) {
    .positions-container { padding: 80px 16px 24px; }
    .page-header h2 { font-size: 22px; }
    .stat-card { padding: 18px; }
    .stat-card .value { font-size: 18px; }
}
</style>

<div class="positions-container">
    <div class="page-header">
        <div>
            <h2>Open Positions</h2>
            <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Live Market Data</span>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="/trading" class="nav-btn">← Dashboard</a>
            <a href="/trading" class="nav-btn primary">New Trade</a>
        </div>
    </div>

    <div class="stale-banner" id="staleBanner">
        <span>⚠</span>
        <span>Live price updates are currently unavailable. Showing last known prices.</span>
    </div>

    <!-- Portfolio Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="label">Account Balance</div>
            <div class="value"><%= formatCurrency(account.balance, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Equity</div>
            <div class="value"><%= formatCurrency(account.equity, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Unrealized P&L</div>
            <div class="value <%= account.totalOpenPnL >= 0 ? 'positive' : 'negative' %>">
                <%= account.totalOpenPnL >= 0 ? '+' : '' %><%= formatCurrency(Math.abs(account.totalOpenPnL), account.currency) %>
            </div>
        </div>
        <div class="stat-card">
            <div class="label">Open Positions</div>
            <div class="value"><%= openCount %></div>
        </div>
        <div class="stat-card">
            <div class="label">Used Margin</div>
            <div class="value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Free Margin</div>
            <div class="value"><%= formatCurrency(account.freeMargin, account.currency) %></div>
        </div>
    </div>

    <!-- Positions Table -->
    <div class="positions-card">
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Side</th>
                    <th>Size</th>
                    <th>Entry Price</th>
                    <th>Current Price</th>
                    <th>Pips</th>
                    <th>P&L</th>
                    <th>Margin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="positionsBody">
                <% if (positions && positions.length > 0) { %>
                    <% positions.forEach(pos => { 
                        const priceDiff = pos.direction === 'buy' 
                            ? pos.current_price - pos.entry_price 
                            : pos.entry_price - pos.current_price;
                    %>
                        <tr data-position-id="<%= pos.id %>" data-symbol="<%= pos.pair_symbol %>">
                            <td>
                                <div class="asset-cell">
                                    <div class="asset-icon"><%= pos.pair_symbol.substring(0, 2) %></div>
                                    <div>
                                        <div style="font-family: var(--font-body); font-weight: 600; color: var(--text-primary);"><%= pos.pair_symbol %></div>
                                        <div style="font-family: var(--font-body); font-size: 12px; color: var(--text-secondary);"><%= pos.pair_name %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="side-badge side-<%= pos.direction %>"><%= pos.direction %></span>
                            </td>
                            <td><%= pos.lot_size %> lots</td>
                            <td><%= pos.entry_price %></td>
                            <td>
                                <span class="current-price" data-symbol="<%= pos.pair_symbol %>" data-direction="<%= pos.direction %>">
                                    <%= pos.current_price %>
                                </span>
                                <div class="price-change <%= priceDiff >= 0 ? 'up' : 'down' %>">
                                    <%= priceDiff >= 0 ? '▲' : '▼' %> <%= Math.abs(priceDiff).toFixed(5) %>
                                </div>
                            </td>
                            <td class="<%= parseFloat(pos.pips_profit) >= 0 ? 'positive' : 'negative' %>">
                                <%= parseFloat(pos.pips_profit) >= 0 ? '+' : '' %><%= pos.pips_profit %>
                            </td>
                            <td>
                                <span class="pnl-badge <%= parseFloat(pos.profit_loss) >= 0 ? 'pnl-positive' : 'pnl-negative' %>">
                                    <%= parseFloat(pos.profit_loss) >= 0 ? '+' : '' %>$<%= Math.abs(parseFloat(pos.profit_loss)).toFixed(2) %>
                                </span>
                            </td>
                            <td>$<%= parseFloat(pos.margin_required).toFixed(2) %></td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    <% if (pos.stop_loss) { %>
                                        <div class="sl-tp">SL: <span><%= pos.stop_loss %></span></div>
                                    <% } %>
                                    <% if (pos.take_profit) { %>
                                        <div class="sl-tp">TP: <span><%= pos.take_profit %></span></div>
                                    <% } %>
                                    <form action="/trading/positions/<%= pos.id %>/close" method="POST" style="margin-top: 4px;">
                                        <button type="submit" class="close-btn" onclick="return confirm('Close <%= pos.pair_symbol %> <%= pos.direction %> position?')">Close</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M3 3v18h18"/>
                                    <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/>
                                </svg>
                                <h3>No Open Positions</h3>
                                <p>Your trading positions will appear here. Start trading to see them.</p>
                                <a href="/trading" class="nav-btn primary" style="display: inline-block; margin-top: 16px;">Place First Trade</a>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Auto-refresh prices every 3 seconds
    let priceRefreshFailCount = 0;
    const MAX_SILENT_FAILS = 3; // stop hammering console/endpoint after repeated 404s

    async function refreshPrices() {
        try {
            const response = await fetch('/trading/api/prices');

            // Guard: endpoint missing or erroring returns an HTML page, not JSON.
            const contentType = response.headers.get('content-type') || '';
            if (!response.ok || !contentType.includes('application/json')) {
                throw new Error(`Prices endpoint returned ${response.status} (${contentType || 'no content-type'})`);
            }

            const prices = await response.json();
            priceRefreshFailCount = 0;
            document.getElementById('staleBanner').classList.remove('visible');

            prices.forEach(p => {
                const cells = document.querySelectorAll(`.current-price[data-symbol="${p.symbol}"]`);
                cells.forEach(cell => {
                    const oldPrice = parseFloat(cell.textContent);
                    const newPrice = parseFloat(p.bid);
                    const direction = cell.getAttribute('data-direction');

                    cell.textContent = newPrice.toFixed(5);

                    // Flash color on price change
                    if (newPrice > oldPrice) {
                        cell.style.color = '#2dd4a7';
                    } else if (newPrice < oldPrice) {
                        cell.style.color = '#ef4444';
                    }
                    setTimeout(() => cell.style.color = '', 800);
                });
            });
        } catch (err) {
            priceRefreshFailCount++;
            if (priceRefreshFailCount <= MAX_SILENT_FAILS) {
                console.warn('Price refresh failed:', err.message);
            }
            if (priceRefreshFailCount === MAX_SILENT_FAILS) {
                console.warn('Suppressing further price-refresh error logs; endpoint /trading/api/prices still unavailable.');
                document.getElementById('staleBanner').classList.add('visible');
            }
        }
    }

    // Refresh every 3 seconds
    setInterval(refreshPrices, 3000);

    // Initial refresh
    refreshPrices();
</script>

<%- include('../partials/footer') %>