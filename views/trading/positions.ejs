<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<link rel="stylesheet" href="../../css/position.css">

<div class="positions-container">
    <div class="page-header">
        <div>
            <h2>Open Positions</h2>
            <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Live Market Data</span>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="/dashboard" class="nav-btn">← Dashboard</a>
            <a href="/trading" class="nav-btn primary">New Trade</a>
        </div>
    </div>

    <div class="stale-banner" id="staleBanner">
        <span>⚠</span>
        <span>Live price updates are currently unavailable. Showing last known prices.</span>
    </div>

    <!-- Portfolio Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="label">Account Balance</div>
            <div class="value"><%= formatCurrency(account.balance, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Equity</div>
            <div class="value"><%= formatCurrency(account.equity, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Unrealized P&L</div>
            <div class="value <%= account.totalOpenPnL >= 0 ? 'positive' : 'negative' %>">
                <%= account.totalOpenPnL >= 0 ? '+' : '' %><%= formatCurrency(Math.abs(account.totalOpenPnL), account.currency) %>
            </div>
        </div>
        <div class="stat-card">
            <div class="label">Open Positions</div>
            <div class="value"><%= openCount %></div>
        </div>
        <div class="stat-card">
            <div class="label">Used Margin</div>
            <div class="value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
        </div>
        <div class="stat-card">
            <div class="label">Free Margin</div>
            <div class="value"><%= formatCurrency(account.freeMargin, account.currency) %></div>
        </div>
    </div>

    <!-- Positions Table -->
    <div class="positions-card">
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Side</th>
                    <th>Size</th>
                    <th>Entry Price</th>
                    <th>Current Price</th>
                    <th>Pips</th>
                    <th>P&L</th>
                    <th>Margin</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="positionsBody">
                <% if (positions && positions.length > 0) { %>
                    <% positions.forEach(pos => { 
                        const priceDiff = pos.direction === 'buy' 
                            ? pos.current_price - pos.entry_price 
                            : pos.entry_price - pos.current_price;
                    %>
                        <tr data-position-id="<%= pos.id %>" data-symbol="<%= pos.pair_symbol %>">
                            <td>
                                <div class="asset-cell">
                                    <div class="asset-icon"><%= pos.pair_symbol.substring(0, 2) %></div>
                                    <div>
                                        <div style="font-family: var(--font-body); font-weight: 600; color: var(--text-primary);"><%= pos.pair_symbol %></div>
                                        <div style="font-family: var(--font-body); font-size: 12px; color: var(--text-secondary);"><%= pos.pair_name %></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="side-badge side-<%= pos.direction %>"><%= pos.direction %></span>
                            </td>
                            <td><%= pos.lot_size %> lots</td>
                            <td><%= pos.entry_price %></td>
                            <td>
                                <span class="current-price" data-symbol="<%= pos.pair_symbol %>" data-direction="<%= pos.direction %>">
                                    <%= pos.current_price %>
                                </span>
                                <div class="price-change <%= priceDiff >= 0 ? 'up' : 'down' %>">
                                    <%= priceDiff >= 0 ? '▲' : '▼' %> <%= Math.abs(priceDiff).toFixed(5) %>
                                </div>
                            </td>
                            <td class="<%= parseFloat(pos.pips_profit) >= 0 ? 'positive' : 'negative' %>">
                                <%= parseFloat(pos.pips_profit) >= 0 ? '+' : '' %><%= pos.pips_profit %>
                            </td>
                            <td>
                                <span class="pnl-badge <%= parseFloat(pos.profit_loss) >= 0 ? 'pnl-positive' : 'pnl-negative' %>">
                                    <%= parseFloat(pos.profit_loss) >= 0 ? '+' : '' %>$<%= Math.abs(parseFloat(pos.profit_loss)).toFixed(2) %>
                                </span>
                            </td>
                            <td>$<%= parseFloat(pos.margin_required).toFixed(2) %></td>
                            <td>
                                <div style="display: flex; flex-direction: column; gap: 6px;">
                                    <% if (pos.stop_loss) { %>
                                        <div class="sl-tp">SL: <span><%= pos.stop_loss %></span></div>
                                    <% } %>
                                    <% if (pos.take_profit) { %>
                                        <div class="sl-tp">TP: <span><%= pos.take_profit %></span></div>
                                    <% } %>
                                    <form action="/trading/positions/<%= pos.id %>/close" method="POST" style="margin-top: 4px;">
                                        <button type="submit" class="close-btn" onclick="return confirm('Close <%= pos.pair_symbol %> <%= pos.direction %> position?')">Close</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M3 3v18h18"/>
                                    <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/>
                                </svg>
                                <h3>No Open Positions</h3>
                                <p>Your trading positions will appear here. Start trading to see them.</p>
                                <a href="/trading" class="nav-btn primary" style="display: inline-block; margin-top: 16px;">Place First Trade</a>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Auto-refresh prices every 3 seconds
    let priceRefreshFailCount = 0;
    const MAX_SILENT_FAILS = 3; // stop hammering console/endpoint after repeated 404s

    async function refreshPrices() {
        try {
            const response = await fetch('/trading/api/prices');

            // Guard: endpoint missing or erroring returns an HTML page, not JSON.
            const contentType = response.headers.get('content-type') || '';
            if (!response.ok || !contentType.includes('application/json')) {
                throw new Error(`Prices endpoint returned ${response.status} (${contentType || 'no content-type'})`);
            }

            const prices = await response.json();
            priceRefreshFailCount = 0;
            document.getElementById('staleBanner').classList.remove('visible');

            prices.forEach(p => {
                const cells = document.querySelectorAll(`.current-price[data-symbol="${p.symbol}"]`);
                cells.forEach(cell => {
                    const oldPrice = parseFloat(cell.textContent);
                    const newPrice = parseFloat(p.bid);
                    const direction = cell.getAttribute('data-direction');

                    cell.textContent = newPrice.toFixed(5);

                    // Flash color on price change
                    if (newPrice > oldPrice) {
                        cell.style.color = '#2dd4a7';
                    } else if (newPrice < oldPrice) {
                        cell.style.color = '#ef4444';
                    }
                    setTimeout(() => cell.style.color = '', 800);
                });
            });
        } catch (err) {
            priceRefreshFailCount++;
            if (priceRefreshFailCount <= MAX_SILENT_FAILS) {
                console.warn('Price refresh failed:', err.message);
            }
            if (priceRefreshFailCount === MAX_SILENT_FAILS) {
                console.warn('Suppressing further price-refresh error logs; endpoint /trading/api/prices still unavailable.');
                document.getElementById('staleBanner').classList.add('visible');
            }
        }
    }

    // Refresh every 3 seconds
    setInterval(refreshPrices, 3000);

    // Initial refresh
    refreshPrices();
</script>

<%- include('../partials/footer') %>