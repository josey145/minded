<%
// Ensure that the user object is defined and has the necessary properties
const displayName = (user && (user.display_name || user.username || user.email)) || 'User';
const userInitial = displayName.charAt(0).toUpperCase();
const userCurrency = (user && user.currency) || 'USD';
%>

<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
/* Include the dashboard CSS for styling */
<link rel="stylesheet" href="../../css/dashboard.css">



<div class="dashboard-wrapper">
  <div class="dashboard-container">

    <header class="user-header animate-fadeInUp">
      <div class="user-profile">
        <div class="user-avatar">
          <%= userInitial %>
        </div>
        <div class="user-info">
          <span class="user-greeting">Good to see you,</span>
          <h1 class="user-name"><%= displayName %></h1>
          <% if (user && user.account_verified) { %>
            <span class="user-status verified">
              <i class="fas fa-shield-check"></i> Verified Account
            </span>
          <% } else { %>
            <span class="user-status pending">
              <i class="fas fa-clock"></i> Pending Verification
            </span>
          <% } %>
        </div>
      </div>
      <!-- REMOVED: duplicate .user-actions Invest/Withdraw buttons.
           Invest Now / Withdraw already exist below in .balance-hero-actions,
           so there is now only ONE of each button on the page. -->
    </header>

    <section class="balance-hero animate-fadeInUp" style="animation-delay: 0.1s;">
      <div class="balance-hero-inner">
        <div class="balance-hero-label">
          <i class="fas fa-wallet"></i> Available Balance
        </div>
        <div class="balance-hero-amount"><%= userCurrency + ' ' + (balanceFormatted || '0.00') %></div>
        <div class="balance-hero-currency">
          Currency: <%= userCurrency %>
        </div>
        <div class="balance-hero-actions">
          <a href="/investments" class="btn btn-primary">
            <i class="fas fa-plus"></i> Invest Now
          </a>
          <a href="/transactions/withdraw/verify" class="btn btn-ghost">
            <i class="fas fa-arrow-up"></i> Withdraw
          </a>
        </div>
      </div>
    </section>

    <% if (typeof warnings !== 'undefined' && warnings && warnings.length > 0) { %>
      <% warnings.forEach((warning, index) => { 
        let alertType, iconSymbol;
        switch(warning.type) {
          case 'warning': alertType = 'warning'; iconSymbol = 'fa-exclamation-triangle'; break;
          case 'pending': alertType = 'info'; iconSymbol = 'fa-clock'; break;
          case 'welcome': alertType = 'success'; iconSymbol = 'fa-hand-sparkles'; break;
          default: alertType = 'info'; iconSymbol = 'fa-envelope';
        }
      %>
      <div class="alert-banner <%= alertType %>" id="alert-<%= warning.id %>" style="animation-delay: <%= 0.2 + (index * 0.1) %>s;">
        <div class="alert-banner-icon"><i class="fas <%= iconSymbol %>"></i></div>
        <div class="alert-banner-body">
          <div class="alert-banner-title"><%= warning.title %></div>
          <div class="alert-banner-text"><%= warning.message %></div>
          <div class="alert-banner-actions">
            <a href="<%= warning.action_url || '/messages' %>" class="alert-banner-btn primary">
              <%= warning.action_text || 'Read' %>
            </a>
            <button class="alert-banner-btn ghost" onclick="dismissAlert('<%= warning.id %>')">Dismiss</button>
          </div>
        </div>
        <button class="alert-banner-close" onclick="dismissAlert('<%= warning.id %>')"><i class="fas fa-times"></i></button>
      </div>
      <% }) %>
    <% } %>

    <section class="stats-row reveal">
      <div class="stat-box purple">
        <div class="stat-box-header">
          <span class="stat-box-label">Portfolio Value</span>
          <div class="stat-box-icon purple"><i class="fas fa-chart-pie"></i></div>
        </div>
        <div class="stat-box-value"><%= userCurrency + ' ' + (totalValueFormatted || '0.00') %></div>
        <% if (typeof tradeStats !== 'undefined' && tradeStats.winRate > 0) { %>
          <div class="stat-box-sub">
            <span class="stat-box-change <%= parseFloat((unrealizedPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? 'up' : 'down' %>">
              <i class="fas fa-arrow-<%= parseFloat((unrealizedPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? 'up' : 'down' %>"></i>
              Unrealized <%= userCurrency + ' ' + (unrealizedPnLFormatted || '0.00') %>
            </span>
          </div>
        <% } else { %>
          <div class="stat-box-sub"><%= (typeof tradeStats !== 'undefined' ? tradeStats.openPositions : 0) %> active positions</div>
        <% } %>
      </div>

      <div class="stat-box green">
        <div class="stat-box-header">
          <span class="stat-box-label">Active Investments</span>
          <div class="stat-box-icon green"><i class="fas fa-chart-line"></i></div>
        </div>
        <div class="stat-box-value"><%= userCurrency + ' ' + (activeInvestmentFormatted || '0.00') %></div>
        <div class="stat-box-sub"><%= (typeof tradeStats !== 'undefined' ? tradeStats.openPositions : 0) %> open trades</div>
      </div>

      <div class="stat-box blue">
        <div class="stat-box-header">
          <span class="stat-box-label">Total Profit/Loss</span>
          <div class="stat-box-icon blue"><i class="fas fa-wallet"></i></div>
        </div>
        <div class="stat-box-value <%= parseFloat((totalPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? 'positive' : 'negative' %>">
          <%= parseFloat((totalPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? '+' : '' %><%= userCurrency + ' ' + (totalPnLFormatted || '0.00') %>
        </div>
        <div class="stat-box-sub">
          <%= (typeof tradeStats !== 'undefined' ? tradeStats.winningTrades : 0) %>W / <%= (typeof tradeStats !== 'undefined' ? tradeStats.losingTrades : 0) %>L 
          &bull; <%= (typeof tradeStats !== 'undefined' ? tradeStats.winRate : 0) %>% win rate
        </div>
      </div>

      <div class="stat-box orange">
        <div class="stat-box-header">
          <span class="stat-box-label">Total Deposits</span>
          <div class="stat-box-icon orange"><i class="fas fa-arrow-down"></i></div>
        </div>
        <div class="stat-box-value" style="color: var(--green);">
          <%= userCurrency + ' ' + (typeof totalDepositsFormatted !== 'undefined' ? totalDepositsFormatted : '0.00') %>
        </div>
        <div class="stat-box-sub"><%= typeof totalDepositsCount !== 'undefined' ? totalDepositsCount : 0 %> deposits</div>
      </div>
    </section>

    <div class="main-grid">
      <div class="main-left">
        <div class="card reveal">
          <div class="chart-area">
            <div class="chart-header">
              <div class="chart-value-group">
                <div class="chart-main-value"><%= userCurrency + ' ' + (balanceFormatted || '0.00') %></div>
                <div class="chart-sub-value">
                  Balance Overview &bull; <%= userCurrency %>
                  <span class="chart-badge <%= parseFloat((totalPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? 'up' : 'down' %>">
                    <i class="fas fa-arrow-<%= parseFloat((totalPnLFormatted || '0').replace(/[^0-9.-]/g, '')) >= 0 ? 'up' : 'down' %>"></i>
                    <%= (typeof tradeStats !== 'undefined' ? tradeStats.winRate : 0) %>% win rate
                  </span>
                </div>
              </div>
              <div class="chart-tabs">
                <button class="chart-tab active">1D</button>
                <button class="chart-tab">1W</button>
                <button class="chart-tab">1M</button>
                <button class="chart-tab">1Y</button>
              </div>
            </div>
            <div class="chart-visual">
              <div class="chart-line"></div>
            </div>
          </div>
        </div>

        <% if (typeof activeInvestments !== 'undefined' && activeInvestments && activeInvestments.length > 0) { %>
        <div class="card reveal" style="margin-top: 20px;">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-briefcase"></i> Active Positions</h3>
            <span class="pl-badge positive"><%= activeInvestments.length %> Open</span>
          </div>
          <div class="card-body">
            <div class="positions-list">
              <% activeInvestments.forEach(trade => { %>
              <div class="position-item">
                <div class="position-info">
                  <div class="position-pair">
                    <span class="position-symbol"><%= trade.pair_symbol || trade.symbol || 'N/A' %></span>
                    <span class="position-name"><%= trade.pair_name || '' %></span>
                  </div>
                  <span class="position-tag <%= trade.direction || 'buy' %>"><%= (trade.direction || 'buy').toUpperCase() %></span>
                </div>
                <div class="position-metrics">
                  <div class="position-metric">
                    <div class="position-metric-label">Entry Price</div>
                    <div class="position-metric-value">
                      <%= typeof formatCurrency !== 'undefined' ? formatCurrency(trade.converted_entry_price || trade.entry_price, displayCurrency) : (trade.converted_entry_price || trade.entry_price || '0') %>
                    </div>
                  </div>
                  <div class="position-metric">
                    <div class="position-metric-label">Lot Size</div>
                    <div class="position-metric-value"><%= trade.lot_size || '0' %></div>
                  </div>
                </div>
                <div class="position-pnl <%= parseFloat(trade.converted_profit_loss || trade.profit_loss || 0) >= 0 ? 'positive' : 'negative' %>">
                  <%= parseFloat(trade.converted_profit_loss || trade.profit_loss || 0) >= 0 ? '+' : '' %>
                  <%= typeof formatCurrency !== 'undefined' ? formatCurrency(trade.converted_profit_loss || trade.profit_loss, displayCurrency) : (trade.converted_profit_loss || trade.profit_loss || '0') %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
        <% } %>

        <% if (typeof recentTrades !== 'undefined' && recentTrades && recentTrades.length > 0) { %>
        <div class="card reveal" style="margin-top: 20px;">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-list-alt"></i> Recent Trading Activity</h3>
          </div>
          <div class="card-body">
            <div class="activity-list">
              <% recentTrades.forEach(trade => { %>
              <div class="activity-item">
                <div class="activity-info">
                  <div class="activity-title">
                    <%= (trade.direction || 'buy').toUpperCase() %> <%= trade.pair_symbol || 'N/A' %>
                    <span class="pl-badge <%= (trade.profit_loss || 0) > 0 ? 'positive' : 'negative' %>">
                      <%= (trade.profit_loss || 0) > 0 ? '+' : '' %><%= userCurrency + ' ' + parseFloat(trade.profit_loss || 0).toFixed(2) %>
                    </span>
                  </div>
                  <div class="activity-meta">
                    <%= trade.closed_at ? new Date(trade.closed_at).toLocaleDateString() : 'N/A' %> 
                    &bull; <%= trade.lot_size || 0 %> lots @ <%= trade.leverage_used || 1 %>x
                  </div>
                </div>
                <div class="activity-value <%= (trade.profit_loss || 0) > 0 ? 'positive' : 'negative' %>">
                  <%= (trade.profit_loss || 0) > 0 ? '+' : '' %><%= userCurrency + ' ' + Math.abs(parseFloat(trade.profit_loss || 0)).toFixed(2) %>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
        <% } else { %>
        <div class="card reveal" style="margin-top: 20px;">
          <div class="card-body">
            <div class="empty-state">
              <i class="fas fa-history"></i>
              <p>No trading activity yet</p>
              <a href="/trading">Start Trading &rarr;</a>
            </div>
          </div>
        </div>
        <% } %>
      </div>

      <div class="main-right">
        <div class="ticker-widget reveal">
          <div class="ticker-widget-header">
            <div class="ticker-widget-icon"><i class="fab fa-bitcoin"></i></div>
            <span class="ticker-widget-name">Bitcoin</span>
            <span class="ticker-widget-live"><span class="ticker-widget-live-dot"></span> Live</span>
          </div>
          <div class="ticker-widget-price" id="btcPrice">$0.00</div>
          <div class="ticker-widget-change up" id="btcChange"><i class="fas fa-arrow-up"></i> 0.00%</div>
        </div>

        <div class="card reveal">
          <div class="card-header">
            <h3 class="card-title"><i class="fas fa-th-large"></i> Quick Access</h3>
          </div>
          <div class="card-body">
            <div class="widget-list">
              <a href="/profile" class="widget-item">
                <div class="widget-icon purple"><i class="fas fa-user"></i></div>
                <div class="widget-content">
                  <div class="widget-title">Profile</div>
                  <div class="widget-desc">Edit your information</div>
                </div>
              </a>

              <a href="/transactions/history" class="widget-item">
                <div class="widget-icon orange"><i class="fas fa-history"></i></div>
                <div class="widget-content">
                  <div class="widget-title">History</div>
                  <div class="widget-desc">Transaction records</div>
                </div>
              </a>

              <a href="/trading" class="widget-item">
                <div class="widget-icon green"><i class="fas fa-exchange-alt"></i></div>
                <div class="widget-content">
                  <div class="widget-title">Trading</div>
                  <div class="widget-desc">Forex & Crypto</div>
                </div>
              </a>

              <a href="/investments" class="widget-item">
                <div class="widget-icon blue"><i class="fas fa-chart-line"></i></div>
                <div class="widget-content">
                  <div class="widget-title">Investments</div>
                  <div class="widget-desc">View portfolio</div>
                </div>
              </a>

              <a href="/messages" class="widget-item">
                <div class="widget-icon pink" style="position: relative;">
                  <i class="fas fa-envelope"></i>
                  <% if (typeof unreadMessages !== 'undefined' && unreadMessages > 0) { %>
                  <span class="widget-badge" style="position: absolute; top: -4px; right: -4px;"><%= unreadMessages %></span>
                  <% } %>
                </div>
                <div class="widget-content">
                  <div class="widget-title">Messages</div>
                  <div class="widget-desc"><%= typeof unreadMessages !== 'undefined' && unreadMessages > 0 ? unreadMessages + ' unread' : 'Inbox' %></div>
                </div>
              </a>

              <a href="/profile/settings" class="widget-item">
                <div class="widget-icon cyan"><i class="fas fa-cog"></i></div>
                <div class="widget-content">
                  <div class="widget-title">Settings</div>
                  <div class="widget-desc">Preferences</div>
                </div>
              </a>

              <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
              <a href="/admin" class="widget-item">
                <div class="widget-icon red"><i class="fas fa-shield-alt"></i></div>
                <div class="widget-content">
                  <div class="widget-title">Admin</div>
                  <div class="widget-desc">Manage system</div>
                </div>
              </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

