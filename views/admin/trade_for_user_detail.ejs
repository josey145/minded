<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<style>
    .admin-detail-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px 16px;
    }

    .page-header {
        margin-bottom: 32px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 800;
        color: #f4f4f5;
        margin-bottom: 8px;
        background: linear-gradient(135deg, #8b5cf6, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .page-subtitle {
        color: #71717a;
        font-size: 15px;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 32px;
    }

    .stat-card {
        background: linear-gradient(135deg, #1a1a2e, #16213e);
        border: 1px solid #2a2a3e;
        border-radius: 16px;
        padding: 24px;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
    }

    .stat-card.balance::before { background: linear-gradient(90deg, #8b5cf6, #a78bfa); }
    .stat-card.equity::before { background: linear-gradient(90deg, #22c55e, #4ade80); }
    .stat-card.margin::before { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
    .stat-card.free-margin::before { background: linear-gradient(90deg, #3b82f6, #60a5fa); }

    .stat-label {
        color: #71717a;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: #f4f4f5;
        font-family: 'Courier New', monospace;
    }

    /* Panels */
    .panel {
        background: #111118;
        border: 1px solid #1e1e2e;
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .panel-title {
        font-size: 18px;
        font-weight: 700;
        color: #f4f4f5;
    }

    /* Trade Form */
    .trade-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-label {
        color: #a1a1aa;
        font-size: 13px;
        font-weight: 500;
    }

    .form-input, .form-select {
        background: #0d0d14;
        border: 1px solid #2a2a3e;
        border-radius: 10px;
        padding: 12px 16px;
        color: #f4f4f5;
        font-size: 14px;
        font-family: 'Courier New', monospace;
    }

    .form-input:focus, .form-select:focus {
        outline: none;
        border-color: #8b5cf6;
    }

    .btn-trade {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
        color: white;
        border: none;
        padding: 14px 32px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-trade:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
    }

    .btn-buy {
        background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .btn-sell {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }

    /* Positions Table */
    .positions-table {
        width: 100%;
        border-collapse: collapse;
    }

    .positions-table th {
        color: #71717a;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: left;
        padding: 14px 16px;
        border-bottom: 1px solid #2a2a3e;
        font-weight: 600;
    }

    .positions-table td {
        padding: 16px;
        border-bottom: 1px solid #1e1e2e;
        color: #a1a1aa;
        font-size: 14px;
    }

    .positions-table tr:hover {
        background: rgba(139, 92, 246, 0.05);
    }

    .position-pair {
        font-weight: 700;
        color: #f4f4f5;
    }

    .position-direction {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .position-direction.buy {
        background: rgba(34, 197, 94, 0.2);
        color: #22c55e;
    }

    .position-direction.sell {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .position-price {
        font-family: 'Courier New', monospace;
        font-weight: 600;
    }

    .position-pnl.positive {
        color: #22c55e;
        font-weight: 700;
    }

    .position-pnl.negative {
        color: #ef4444;
        font-weight: 700;
    }

    .btn-close-win {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-close-win:hover {
        background: #22c55e;
        color: white;
    }

    .btn-close-loss {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-close-loss:hover {
        background: #ef4444;
        color: white;
    }

    .btn-force {
        background: #1e1e2e;
        color: #a78bfa;
        border: 1px solid #2a2a3e;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    /* Alert */
    .alert {
        padding: 16px 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .alert-success {
        background: rgba(34, 197, 94, 0.1);
        border: 1px solid rgba(34, 197, 94, 0.3);
        color: #22c55e;
    }

    .alert-error {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #ef4444;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #52525b;
    }

    /* Mobile */
    @media (max-width: 768px) {
        .admin-detail-container { padding: 16px 12px; }
        .page-title { font-size: 24px; }
        .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .stat-card { padding: 16px; }
        .stat-value { font-size: 22px; }
        .panel { padding: 16px; }
        .trade-form { grid-template-columns: 1fr; }
        .positions-table { display: block; overflow-x: auto; }
    }
</style>

<div class="admin-detail-container">
    <div class="page-header">
        <h1 class="page-title">Trading for <%= targetUser.username %></h1>
        <p class="page-subtitle">
            <%= targetUser.account_type === 'demo' ? 'Demo' : 'Real' %> Account | 
            <%= targetUser.email %>
        </p>
    </div>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">✅ <%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">❌ <%= error_msg %></div>
    <% } %>

    <!-- Account Stats -->
    <div class="stats-grid">
        <div class="stat-card balance">
            <div class="stat-label"><%= targetUser.account_type === 'demo' ? 'Demo Balance' : 'Real Balance' %></div>
            <div class="stat-value"><%= formatCurrency(account.balance, account.currency) %></div>
        </div>
        <div class="stat-card equity">
            <div class="stat-label">Equity</div>
            <div class="stat-value"><%= formatCurrency(account.equity, account.currency) %></div>
        </div>
        <div class="stat-card margin">
            <div class="stat-label">Used Margin</div>
            <div class="stat-value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
        </div>
        <div class="stat-card free-margin">
            <div class="stat-label">Free Margin</div>
            <div class="stat-value"><%= formatCurrency(account.freeMargin, account.currency) %></div>
        </div>
    </div>

    <!-- Open Trade Form -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Open Position for <%= targetUser.username %></h3>
        </div>
        <form action="/admin/trade-for-user/open-position" method="POST" class="trade-form">
            <input type="hidden" name="user_id" value="<%= targetUser.id %>">
            <div class="form-group">
                <label class="form-label">Currency Pair</label>
                <select name="pair_id" class="form-select" required>
                    <% pairs.forEach(pair => { %>
                        <option value="<%= pair.id %>"><%= pair.name %> (<%= pair.symbol %>)</option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Direction</label>
                <select name="direction" class="form-select" required>
                    <option value="buy">Buy (Long)</option>
                    <option value="sell">Sell (Short)</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Lot Size</label>
                <input type="number" name="lot_size" class="form-input" step="0.01" min="0.01" value="0.10" required>
            </div>
            <div class="form-group">
                <label class="form-label">Leverage</label>
                <select name="leverage" class="form-select">
                    <option value="50">1:50</option>
                    <option value="100" selected>1:100</option>
                    <option value="200">1:200</option>
                    <option value="500">1:500</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Stop Loss (optional)</label>
                <input type="number" name="stop_loss" class="form-input" step="0.00001">
            </div>
            <div class="form-group">
                <label class="form-label">Take Profit (optional)</label>
                <input type="number" name="take_profit" class="form-input" step="0.00001">
            </div>
            <div class="form-group">
                <label class="form-label">Force Result</label>
                <select name="forced_result" class="form-select">
                    <option value="none">No Force</option>
                    <option value="win">Force Win</option>
                    <option value="loss">Force Loss</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Notes</label>
                <input type="text" name="notes" class="form-input" placeholder="Optional notes...">
            </div>
            <div class="form-group" style="display: flex; align-items: flex-end; gap: 12px;">
                <button type="submit" class="btn-trade btn-buy" style="flex: 1;">Open Buy</button>
                <button type="submit" class="btn-trade btn-sell" style="flex: 1;">Open Sell</button>
            </div>
        </form>
    </div>

    <!-- Open Positions -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Open Positions</h3>
            <% if (openPositions.length > 0) { %>
            <form action="/admin/trade-for-user/bulk-close/<%= targetUser.id %>" method="POST" style="display: inline;">
                <input type="hidden" name="forced_result_all" value="none">
                <button type="submit" class="btn-force" onclick="return confirm('Close ALL positions for <%= targetUser.username %>?')">Close All</button>
            </form>
            <% } %>
        </div>
        <% if (openPositions.length > 0) { %>
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Direction</th>
                    <th>Lots</th>
                    <th>Entry Price</th>
                    <th>Current</th>
                    <th>P&L</th>
                    <th>Force</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% openPositions.forEach(pos => { %>
                    <% const pnl = parseFloat(pos.profit_loss) || 0; %>
                    <% const entryPrice = parseFloat(pos.entry_price) || 0; %>
                    <% const currentPrice = parseFloat(pos.current_price) || 0; %>
                    <tr>
                        <td class="position-pair"><%= pos.pair_symbol %></td>
                        <td>
                            <span class="position-direction <%= pos.direction %>"><%= pos.direction %></span>
                        </td>
                        <td class="position-price"><%= pos.lot_size %> lots</td>
                        <td class="position-price"><%= entryPrice.toFixed(5) %></td>
                        <td class="position-price"><%= currentPrice.toFixed(5) %></td>
                        <td class="position-pnl <%= pnl >= 0 ? 'positive' : 'negative' %>">
                            <%= pnl >= 0 ? '+' : '' %><%= formatCurrency(pnl, account.currency) %>
                        </td>
                        <td>
                            <form action="/admin/trade-for-user/set-force-result/<%= pos.id %>" method="POST" style="display: flex; gap: 4px;">
                                <select name="forced_result" class="form-select" style="font-size: 11px; padding: 4px 8px;">
                                    <option value="none" <%= pos.forced_result === 'none' ? 'selected' : '' %>>None</option>
                                    <option value="win" <%= pos.forced_result === 'win' ? 'selected' : '' %>>Win</option>
                                    <option value="loss" <%= pos.forced_result === 'loss' ? 'selected' : '' %>>Loss</option>
                                </select>
                                <button type="submit" class="btn-force">Set</button>
                            </form>
                        </td>
                        <td style="display: flex; gap: 8px;">
                            <form action="/admin/trade-for-user/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                <input type="hidden" name="forced_pnl" value="<%= Math.abs((parseFloat(pos.margin_required) || 0) * 0.5 + Math.random() * (parseFloat(pos.margin_required) || 0)).toFixed(2) %>">
                                <input type="hidden" name="notes" value="Force win closed by admin">
                                <button type="submit" class="btn-close-win" onclick="return confirm('Close as WIN?')">✓ Win</button>
                            </form>
                            <form action="/admin/trade-for-user/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                <input type="hidden" name="forced_pnl" value="-<%= Math.abs((parseFloat(pos.margin_required) || 0) * 0.3 + Math.random() * (parseFloat(pos.margin_required) || 0) * 0.5).toFixed(2) %>">
                                <input type="hidden" name="notes" value="Force loss closed by admin">
                                <button type="submit" class="btn-close-loss" onclick="return confirm('Close as LOSS?')">✗ Loss</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <% } else { %>
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">📈</div>
            <p>No open positions for this user.</p>
        </div>
        <% } %>
    </div>

    <!-- Trade History -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Trade History</h3>
        </div>
        <% if (tradeHistory.length > 0) { %>
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Direction</th>
                    <th>Entry</th>
                    <th>Exit</th>
                    <th>P&L</th>
                    <th>Closed</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                <% tradeHistory.forEach(trade => { %>
                    <% const pnl = parseFloat(trade.profit_loss) || 0; %>
                    <% const entryPrice = parseFloat(trade.entry_price) || 0; %>
                    <% const exitPrice = parseFloat(trade.exit_price) || 0; %>
                    <tr>
                        <td class="position-pair"><%= trade.pair_symbol %></td>
                        <td>
                            <span class="position-direction <%= trade.direction %>"><%= trade.direction %></span>
                        </td>
                        <td class="position-price"><%= entryPrice.toFixed(5) %></td>
                        <td class="position-price"><%= exitPrice.toFixed(5) %></td>
                        <td class="position-pnl <%= pnl >= 0 ? 'positive' : 'negative' %>">
                            <%= pnl >= 0 ? '+' : '' %><%= formatCurrency(pnl, account.currency) %>
                        </td>
                        <td><%= new Date(trade.closed_at).toLocaleDateString() %></td>
                        <td><%= trade.close_reason || 'User closed' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        <% } else { %>
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
            <p>No trade history yet.</p>
        </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>