<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

:root {
    --void: #0a0a0f;
    --void-elevated: #111118;
    --void-card: #14141d;
    --void-hover: #1a1a26;
    --border: #1e1e2e;
    --border-light: rgba(255,255,255,0.06);

    --text-primary: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-muted: #52525b;

    --mint: #2dd4a7;
    --mint-glow: rgba(45, 212, 167, 0.15);
    --mint-soft: rgba(45, 212, 167, 0.1);
    --indigo: #6366f1;
    --indigo-glow: rgba(99, 102, 241, 0.15);
    --indigo-soft: rgba(99, 102, 241, 0.1);
    --alert: #ef4444;
    --alert-glow: rgba(239, 68, 68, 0.15);
    --alert-soft: rgba(239, 68, 68, 0.1);
    --amber: #f59e0b;
    --amber-soft: rgba(245, 158, 11, 0.1);

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
}

* { box-sizing: border-box; }

.admin-detail-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 16px 40px;
    font-family: var(--font-body);
}

.page-header { margin-bottom: 32px; }

.page-title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.3px;
}

.page-subtitle { color: var(--text-secondary); font-size: 14px; font-family: var(--font-mono); }

.live-indicator { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--mint); margin-top: 8px; font-weight: 500; }
.live-dot { width: 7px; height: 7px; background-color: var(--mint); border-radius: 50%; box-shadow: 0 0 8px var(--mint-glow); animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.stale-banner {
    display: none;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(245,158,11,0.02));
    border: 1px solid rgba(245,158,11,0.2);
    color: var(--amber);
    padding: 12px 18px;
    border-radius: var(--radius-md);
    font-size: 13px;
    margin-bottom: 20px;
}
.stale-banner.visible { display: flex; }

/* Stats Cards */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
}

.stat-card {
    background-color: var(--void-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
}
.stat-card:hover { border-color: var(--border-light); transform: translateY(-2px); }

.stat-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
}

.stat-card.balance::before { background: linear-gradient(90deg, var(--indigo), transparent); }
.stat-card.equity::before { background: linear-gradient(90deg, var(--mint), transparent); }
.stat-card.margin::before { background: linear-gradient(90deg, var(--amber), transparent); }
.stat-card.free-margin::before { background: linear-gradient(90deg, #3b82f6, transparent); }

.stat-label {
    color: var(--text-secondary);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-weight: 600;
    margin-bottom: 10px;
}

.stat-value {
    font-size: 24px;
    font-weight: 600;
    color: var(--text-primary);
    font-family: var(--font-mono);
    letter-spacing: -0.3px;
}

/* Panels */
.panel {
    background: var(--void-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    margin-bottom: 24px;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 12px;
}

.panel-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
}

/* Trade Form */
.trade-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form-label {
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.form-input, .form-select {
    background: var(--void-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 16px;
    color: var(--text-primary);
    font-size: 14px;
    font-family: var(--font-mono);
    transition: border-color 0.2s ease;
}

.form-input:focus, .form-select:focus {
    outline: none;
    border-color: var(--indigo);
    box-shadow: 0 0 0 3px var(--indigo-soft);
}

.btn-trade {
    background: linear-gradient(135deg, var(--indigo), #4f46e5);
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-trade:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--indigo-glow);
}

.btn-buy { background: linear-gradient(135deg, var(--mint), #22b892); color: #06251c; }
.btn-buy:hover { box-shadow: 0 8px 20px var(--mint-glow); }

.btn-sell { background: linear-gradient(135deg, var(--alert), #dc2626); }
.btn-sell:hover { box-shadow: 0 8px 20px var(--alert-glow); }

/* Positions Table */
.positions-table { width: 100%; border-collapse: collapse; min-width: 900px; }

.positions-table th {
    color: var(--text-secondary);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: left;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
    background-color: var(--indigo-soft);
}

.positions-table td {
    padding: 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 14px;
}

.positions-table tr:hover { background: var(--void-hover); }
.positions-table tr:last-child td { border-bottom: none; }

.position-pair { font-family: var(--font-body); font-weight: 700; color: var(--text-primary); }

.position-direction {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-family: var(--font-body);
}

.position-direction.buy { background: var(--mint-soft); color: var(--mint); }
.position-direction.sell { background: var(--alert-soft); color: var(--alert); }

.position-price { font-family: var(--font-mono); font-weight: 600; color: var(--text-primary); }

.price-change { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-family: var(--font-mono); margin-top: 3px; }
.price-change.up { color: var(--mint); }
.price-change.down { color: var(--alert); }

.position-pnl.positive { color: var(--mint); font-weight: 700; font-family: var(--font-mono); }
.position-pnl.negative { color: var(--alert); font-weight: 700; font-family: var(--font-mono); }

.btn-close-win {
    background: var(--mint-soft);
    color: var(--mint);
    border: 1px solid rgba(45, 212, 167, 0.3);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-close-win:hover { background: var(--mint); color: #06251c; }

.btn-close-loss {
    background: var(--alert-soft);
    color: var(--alert);
    border: 1px solid rgba(239, 68, 68, 0.3);
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 700;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-close-loss:hover { background: var(--alert); color: white; }

.btn-force {
    background: var(--void-card);
    color: #a5a6f6;
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.2s ease;
}
.btn-force:hover { background: var(--void-hover); border-color: var(--border-light); }

/* Alert */
.alert {
    padding: 16px 20px;
    border-radius: var(--radius-md);
    margin-bottom: 24px;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
}

.alert-success { background: var(--mint-soft); border: 1px solid rgba(45, 212, 167, 0.3); color: var(--mint); }
.alert-error { background: var(--alert-soft); border: 1px solid rgba(239, 68, 68, 0.3); color: var(--alert); }

.empty-state { text-align: center; padding: 60px 20px; color: var(--text-muted); font-family: var(--font-body); }

/* Mobile */
@media (max-width: 768px) {
    .admin-detail-container { padding: 80px 12px 24px; }
    .page-title { font-size: 22px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .stat-card { padding: 16px; }
    .stat-value { font-size: 20px; }
    .panel { padding: 16px; }
    .trade-form { grid-template-columns: 1fr; }
    .positions-table { display: block; overflow-x: auto; }
}
</style>

<div class="admin-detail-container">
    <div class="page-header">
        <h1 class="page-title">Trading for <%= targetUser.username %></h1>
        <p class="page-subtitle">
            <%= targetUser.account_type === 'demo' ? 'Demo' : 'Real' %> Account &bull; <%= targetUser.email %>
        </p>
        <div class="live-indicator">
            <span class="live-dot"></span>
            <span>Live Market Data</span>
        </div>
    </div>

    <div class="stale-banner" id="staleBanner">
        <span>⚠</span>
        <span>Live price updates are currently unavailable. Showing last known prices.</span>
    </div>

    <!-- Flash Messages -->
    <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success">✅ <%= success_msg %></div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-error">❌ <%= error_msg %></div>
    <% } %>

    <!-- Account Stats -->
    <div class="stats-grid">
        <div class="stat-card balance">
            <div class="stat-label"><%= targetUser.account_type === 'demo' ? 'Demo Balance' : 'Real Balance' %></div>
            <div class="stat-value"><%= formatCurrency(account.balance, account.currency) %></div>
        </div>
        <div class="stat-card equity">
            <div class="stat-label">Equity</div>
            <div class="stat-value"><%= formatCurrency(account.equity, account.currency) %></div>
        </div>
        <div class="stat-card margin">
            <div class="stat-label">Used Margin</div>
            <div class="stat-value"><%= formatCurrency(account.usedMargin, account.currency) %></div>
        </div>
        <div class="stat-card free-margin">
            <div class="stat-label">Free Margin</div>
            <div class="stat-value"><%= formatCurrency(account.freeMargin, account.currency) %></div>
        </div>
    </div>

    <!-- Open Trade Form -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Open Position for <%= targetUser.username %></h3>
        </div>
        <form action="/admin/trade-for-user/open-position" method="POST" class="trade-form">
            <input type="hidden" name="user_id" value="<%= targetUser.id %>">
            <div class="form-group">
                <label class="form-label">Currency Pair</label>
                <select name="pair_id" class="form-select" required>
                    <% pairs.forEach(pair => { %>
                        <option value="<%= pair.id %>"><%= pair.name %> (<%= pair.symbol %>)</option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Direction</label>
                <select name="direction" class="form-select" required>
                    <option value="buy">Buy (Long)</option>
                    <option value="sell">Sell (Short)</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Lot Size</label>
                <input type="number" name="lot_size" class="form-input" step="0.01" min="0.01" value="0.10" required>
            </div>
            <div class="form-group">
                <label class="form-label">Leverage</label>
                <select name="leverage" class="form-select">
                    <option value="50">1:50</option>
                    <option value="100" selected>1:100</option>
                    <option value="200">1:200</option>
                    <option value="500">1:500</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Stop Loss (optional)</label>
                <input type="number" name="stop_loss" class="form-input" step="0.00001">
            </div>
            <div class="form-group">
                <label class="form-label">Take Profit (optional)</label>
                <input type="number" name="take_profit" class="form-input" step="0.00001">
            </div>
            <div class="form-group">
                <label class="form-label">Force Result</label>
                <select name="forced_result" class="form-select">
                    <option value="none">No Force</option>
                    <option value="win">Force Win</option>
                    <option value="loss">Force Loss</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Notes</label>
                <input type="text" name="notes" class="form-input" placeholder="Optional notes...">
            </div>
            <div class="form-group" style="display: flex; align-items: flex-end; gap: 12px;">
                <button type="submit" class="btn-trade btn-buy" style="flex: 1;">Open Buy</button>
                <button type="submit" class="btn-trade btn-sell" style="flex: 1;">Open Sell</button>
            </div>
        </form>
    </div>

    <!-- Open Positions -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Open Positions</h3>
            <% if (openPositions.length > 0) { %>
            <form action="/admin/trade-for-user/bulk-close/<%= targetUser.id %>" method="POST" style="display: inline;">
                <input type="hidden" name="forced_result_all" value="none">
                <button type="submit" class="btn-force" onclick="return confirm('Close ALL positions for <%= targetUser.username %>?')">Close All</button>
            </form>
            <% } %>
        </div>
        <% if (openPositions.length > 0) { %>
        <div style="overflow-x: auto;">
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Direction</th>
                    <th>Lots</th>
                    <th>Entry Price</th>
                    <th>Current</th>
                    <th>P&L</th>
                    <th>Force</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% openPositions.forEach(pos => { %>
                    <% const pnl = parseFloat(pos.profit_loss) || 0; %>
                    <% const entryPrice = parseFloat(pos.entry_price) || 0; %>
                    <% const currentPrice = parseFloat(pos.current_price) || 0; %>
                    <% const priceDiff = pos.direction === 'buy' ? currentPrice - entryPrice : entryPrice - currentPrice; %>
                    <tr data-position-id="<%= pos.id %>" data-symbol="<%= pos.pair_symbol %>">
                        <td class="position-pair"><%= pos.pair_symbol %></td>
                        <td>
                            <span class="position-direction <%= pos.direction %>"><%= pos.direction %></span>
                        </td>
                        <td class="position-price"><%= pos.lot_size %> lots</td>
                        <td class="position-price"><%= entryPrice.toFixed(5) %></td>
                        <td>
                            <span class="position-price current-price" data-symbol="<%= pos.pair_symbol %>" data-direction="<%= pos.direction %>">
                                <%= currentPrice.toFixed(5) %>
                            </span>
                            <div class="price-change <%= priceDiff >= 0 ? 'up' : 'down' %>">
                                <%= priceDiff >= 0 ? '▲' : '▼' %> <%= Math.abs(priceDiff).toFixed(5) %>
                            </div>
                        </td>
                        <td class="position-pnl <%= pnl >= 0 ? 'positive' : 'negative' %>">
                            <%= pnl >= 0 ? '+' : '' %><%= formatCurrency(pnl, account.currency) %>
                        </td>
                        <td>
                            <form action="/admin/trade-for-user/set-force-result/<%= pos.id %>" method="POST" style="display: flex; gap: 4px;">
                                <select name="forced_result" class="form-select" style="font-size: 11px; padding: 4px 8px;">
                                    <option value="none" <%= pos.forced_result === 'none' ? 'selected' : '' %>>None</option>
                                    <option value="win" <%= pos.forced_result === 'win' ? 'selected' : '' %>>Win</option>
                                    <option value="loss" <%= pos.forced_result === 'loss' ? 'selected' : '' %>>Loss</option>
                                </select>
                                <button type="submit" class="btn-force">Set</button>
                            </form>
                        </td>
                        <td style="display: flex; gap: 8px;">
                            <form action="/admin/trade-for-user/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                <input type="hidden" name="forced_pnl" value="<%= Math.abs((parseFloat(pos.margin_required) || 0) * 0.5 + Math.random() * (parseFloat(pos.margin_required) || 0)).toFixed(2) %>">
                                <input type="hidden" name="notes" value="Force win closed by admin">
                                <button type="submit" class="btn-close-win" onclick="return confirm('Close as WIN?')">✓ Win</button>
                            </form>
                            <form action="/admin/trade-for-user/close-position/<%= pos.id %>" method="POST" style="display: inline;">
                                <input type="hidden" name="forced_pnl" value="-<%= Math.abs((parseFloat(pos.margin_required) || 0) * 0.3 + Math.random() * (parseFloat(pos.margin_required) || 0) * 0.5).toFixed(2) %>">
                                <input type="hidden" name="notes" value="Force loss closed by admin">
                                <button type="submit" class="btn-close-loss" onclick="return confirm('Close as LOSS?')">✗ Loss</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
        <% } else { %>
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">📈</div>
            <p>No open positions for this user.</p>
        </div>
        <% } %>
    </div>

    <!-- Trade History -->
    <div class="panel">
        <div class="panel-header">
            <h3 class="panel-title">Trade History</h3>
        </div>
        <% if (tradeHistory.length > 0) { %>
        <div style="overflow-x: auto;">
        <table class="positions-table">
            <thead>
                <tr>
                    <th>Pair</th>
                    <th>Direction</th>
                    <th>Entry</th>
                    <th>Exit</th>
                    <th>P&L</th>
                    <th>Closed</th>
                    <th>Reason</th>
                </tr>
            </thead>
            <tbody>
                <% tradeHistory.forEach(trade => { %>
                    <% const pnl = parseFloat(trade.profit_loss) || 0; %>
                    <% const entryPrice = parseFloat(trade.entry_price) || 0; %>
                    <% const exitPrice = parseFloat(trade.exit_price) || 0; %>
                    <tr>
                        <td class="position-pair"><%= trade.pair_symbol %></td>
                        <td>
                            <span class="position-direction <%= trade.direction %>"><%= trade.direction %></span>
                        </td>
                        <td class="position-price"><%= entryPrice.toFixed(5) %></td>
                        <td class="position-price"><%= exitPrice.toFixed(5) %></td>
                        <td class="position-pnl <%= pnl >= 0 ? 'positive' : 'negative' %>">
                            <%= pnl >= 0 ? '+' : '' %><%= formatCurrency(pnl, account.currency) %>
                        </td>
                        <td class="position-price"><%= new Date(trade.closed_at).toLocaleDateString() %></td>
                        <td><%= trade.close_reason || 'User closed' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
        </div>
        <% } else { %>
        <div class="empty-state">
            <div style="font-size: 48px; margin-bottom: 16px;">📋</div>
            <p>No trade history yet.</p>
        </div>
        <% } %>
    </div>
</div>

<script>
    // Auto-refresh live current prices for open positions (mirrors /trading/positions behavior)
    let priceRefreshFailCount = 0;
    const MAX_SILENT_FAILS = 3;

    async function refreshPrices() {
        try {
            const response = await fetch('/trading/api/prices');

            const contentType = response.headers.get('content-type') || '';
            if (!response.ok || !contentType.includes('application/json')) {
                throw new Error(`Prices endpoint returned ${response.status} (${contentType || 'no content-type'})`);
            }

            const prices = await response.json();
            priceRefreshFailCount = 0;
            const banner = document.getElementById('staleBanner');
            if (banner) banner.classList.remove('visible');

            prices.forEach(p => {
                const cells = document.querySelectorAll(`.current-price[data-symbol="${p.symbol}"]`);
                cells.forEach(cell => {
                    const oldPrice = parseFloat(cell.textContent);
                    const newPrice = parseFloat(p.bid);

                    cell.textContent = newPrice.toFixed(5);

                    if (newPrice > oldPrice) {
                        cell.style.color = '#2dd4a7';
                    } else if (newPrice < oldPrice) {
                        cell.style.color = '#ef4444';
                    }
                    setTimeout(() => cell.style.color = '', 800);
                });
            });
        } catch (err) {
            priceRefreshFailCount++;
            if (priceRefreshFailCount <= MAX_SILENT_FAILS) {
                console.warn('Price refresh failed:', err.message);
            }
            if (priceRefreshFailCount === MAX_SILENT_FAILS) {
                console.warn('Suppressing further price-refresh error logs; endpoint /trading/api/prices still unavailable.');
                const banner = document.getElementById('staleBanner');
                if (banner) banner.classList.add('visible');
            }
        }
    }

    // Only poll if there are open positions on the page
    if (document.querySelector('.current-price')) {
        setInterval(refreshPrices, 3000);
        refreshPrices();
    }
</script>

<%- include('../partials/footer') %>